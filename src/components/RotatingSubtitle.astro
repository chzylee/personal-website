---
const phrases = [
  'Community Builder',
  'Platform Engineer',
  'Problem Solver',
  'Tournament Organizer',
  'Backend Engineer',
];

const CYCLE_DURATION = 15; // seconds — total for all phrases
const STEP = CYCLE_DURATION / phrases.length; // 3s per phrase
---

<div class="subtitle" aria-label={phrases.join(' / ')}>
  {phrases.map((phrase, i) => (
    <span
      class="subtitle__phrase"
      style={`animation-delay: ${i * STEP}s`}
      aria-hidden="true"
    >
      {phrase}
    </span>
  ))}
</div>

<style>
  /*
   * All phrases stack in the same grid cell via grid-area.
   * The grid container expands to the widest phrase, preventing layout shift.
   */
  .subtitle {
    display: grid;
    height: 1.5em;
  }

  .subtitle__phrase {
    grid-area: 1 / 1;
    opacity: 0;
    color: var(--c-text-muted);
    font-size: 1rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
    animation: phrase-cycle 15s infinite;
    animation-fill-mode: backwards;
    /* phrase-cycle keyframes are defined in global.css */
  }
</style>
