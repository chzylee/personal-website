    max-width: 38rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .about__eyebrow {
    margin-bottom: 0.5rem;
  }

  .about__lede {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.005em;
    color: var(--color-ink);
  }

  .about__lede .serif-italic {
    color: var(--color-rust);
    font-size: 0.95em;
    letter-spacing: -0.015em;
  }

  .about__body {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
  }

