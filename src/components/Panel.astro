---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<aside class="panel" id={id} aria-label={title} aria-hidden="true">
  <div class="panel__header">
    <h2 class="panel__title">{title}</h2>
    <button class="panel__close" data-panel-close aria-label={`Close ${title} panel`}>
      <!-- Lucide: x -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18"/>
        <path d="m6 6 12 12"/>
      </svg>
    </button>
  </div>

  <div class="panel__body">
    <slot />
  </div>
</aside>

<style>
  .panel {
    position: fixed;
    top: 0;
    right: 0;
    width: var(--panel-w);
    height: 100dvh;
    background: var(--c-panel-bg);
    border-left: 1px solid var(--c-border);
    transform: translateX(100%);
    transition: transform 0.4s var(--ease-panel);
    z-index: 300;
    display: flex;
    flex-direction: column;
    will-change: transform;
  }

  .panel--open {
    transform: translateX(0);
  }

  /*
   * Sync aria-hidden with the JS-toggled class.
   * (JS also manages aria-hidden directly; this handles the initial state.)
   */
  .panel--open {
    /* overridden by JS inline, but good default */
  }

  .panel__header {
    height: var(--panel-header-h);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--sp-8);
    border-bottom: 1px solid var(--c-border);
  }

  .panel__title {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .panel__close {
    color: var(--c-text);
    opacity: 0.4;
    transition: opacity 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
  }

  .panel__close:hover {
    opacity: 1;
  }

  .panel__body {
    flex: 1;
    overflow-y: auto;
    padding: var(--sp-8);
    /* Custom scrollbar */
    scrollbar-width: thin;
    scrollbar-color: var(--c-border) transparent;
  }

  .panel__body::-webkit-scrollbar {
    width: 4px;
  }

  .panel__body::-webkit-scrollbar-track {
    background: transparent;
  }

  .panel__body::-webkit-scrollbar-thumb {
    background: var(--c-border);
    border-radius: 2px;
  }
</style>
