---
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
---

<header class="sticky-nav">
  <div class="sticky-nav__left">
    <Image
      src={photo}
      alt=""
      width={24}
      height={24}
      class="sticky-nav__photo"
      aria-hidden="true"
    />
    <span class="sticky-nav__name">Noah Lee</span>
  </div>

  <nav class="sticky-nav__links" aria-label="Page sections">
    <a href="#projects" class="sticky-nav__link">Projects</a>
    <a href="#photography" class="sticky-nav__link">Photography</a>
    <a
      href="/NoahLeeResume.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="sticky-nav__link"
    >Resume</a>
  </nav>
</header>

<style>
  .sticky-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    padding: 0 2rem;

    /* Hidden by default; revealed by body.scrolled (toggled in nav.ts) */
    opacity: 0;
    transform: translateY(-100%);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  /* Toggled directly by nav.ts — no body-class indirection needed */
  .sticky-nav--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* ── Left: photo + name ── */
  .sticky-nav__left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .sticky-nav__photo {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
  }

  .sticky-nav__name {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  /* ── Right: links ── */
  .sticky-nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .sticky-nav__link {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text);
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .sticky-nav__link:hover {
    opacity: 1;
  }
</style>
