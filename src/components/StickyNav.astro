---
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
---

<header class="sticky-nav">
  <a href="#" class="sticky-nav__left" aria-label="Back to top">
    <Image
      src={photo}
      alt=""
      width={24}
      height={24}
      class="sticky-nav__photo"
      aria-hidden="true"
    />
    <span class="sticky-nav__name">Noah Lee</span>
  </a>

  <nav class="sticky-nav__links" aria-label="Page sections">
    <a href="/work" class="sticky-nav__link">Work</a>
    <a href="/blog" class="sticky-nav__link">Writing</a>
    <a href="#photography" class="sticky-nav__link">Photography</a>
    <a
      href="/NoahLeeResume.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="sticky-nav__link"
    >Resume</a>
  </nav>
</header>

<style>
  .sticky-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    background: rgba(14, 13, 11, 0.78);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--color-rule);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 2rem;
  }

  .sticky-nav__left {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .sticky-nav__left:hover { color: var(--color-rust); }

  .sticky-nav__photo {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
  }

  .sticky-nav__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    line-height: 1;
    color: inherit;
  }

  .sticky-nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .sticky-nav__link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    transition: color 0.2s ease;
    padding: 0.75rem 0;
  }

  .sticky-nav__link:hover { color: var(--color-rust); }

  @media (max-width: 640px) {
    .sticky-nav {
      gap: 1rem;
      padding: 0 1rem;
    }
    .sticky-nav__links { gap: 1rem; }
    .sticky-nav__link { font-size: 0.6875rem; letter-spacing: 0.06em; }
  }
</style>
