---
// No props — nav is a singleton layout element.
---

<nav class="nav">
  <div class="nav__left">
    <a href="/" class="nav__brand" aria-label="Home">CL</a>
  </div>

  <div class="nav__right">
    <button class="nav__item" data-panel-open="panel-projects" aria-label="Open Projects panel">
      <!-- Lucide: folder -->
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
      </svg>
      <span>Projects</span>
    </button>

    <button class="nav__item" data-panel-open="panel-writing" aria-label="Open Writing panel">
      <!-- Lucide: pen-line -->
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9"/>
        <path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 19.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>
      </svg>
      <span>Writing</span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--sp-8);
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-border);
    z-index: 200;
  }

  .nav__brand {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--c-text);
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .nav__brand:hover {
    opacity: 1;
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }

  .nav__item {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    color: var(--c-text);
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .nav__item:hover {
    opacity: 1;
  }
</style>
