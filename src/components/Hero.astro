---
import RotatingSubtitle from './RotatingSubtitle.astro';
---

<section class="hero" aria-label="Introduction">
  <div class="hero__content">
    <h1 class="hero__name">Chase Lee</h1>
    <RotatingSubtitle />

    <nav class="hero__links" aria-label="Social links">
      <!-- GitHub personal -->
      <a
        href="https://github.com/chzylee"
        target="_blank"
        rel="noopener noreferrer"
        class="hero__link"
        aria-label="GitHub (personal)"
        title="GitHub"
      >
        <!-- Lucide: github -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
          <path d="M9 18c-4.51 2-5-2-7-2"/>
        </svg>
      </a>

      <!-- GitHub org -->
      <a
        href="https://github.com/enpicie"
        target="_blank"
        rel="noopener noreferrer"
        class="hero__link"
        aria-label="GitHub (enpicie org)"
        title="GitHub — enpicie"
      >
        <!-- Lucide: github (org) -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
          <path d="M9 18c-4.51 2-5-2-7-2"/>
          <!-- small dot badge to visually distinguish org icon -->
          <circle cx="20" cy="4" r="2.5" fill="currentColor" stroke="none"/>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://linkedin.com/in/chzylee"
        target="_blank"
        rel="noopener noreferrer"
        class="hero__link"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <!-- LinkedIn mark (not in Lucide — hand-drawn to match style) -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect width="4" height="12" x="2" y="9"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
    </nav>
  </div>
</section>

<style>
  .hero {
    height: calc(100dvh - var(--nav-h));
    margin-top: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }

  .hero__name {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--c-text);
  }

  .hero__links {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    margin-top: var(--sp-4);
  }

  .hero__link {
    color: var(--c-text);
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }

  .hero__link:hover {
    opacity: 1;
  }
</style>
