---
// Attempt 3 ("open reinvention") hero.
//
// A confident, STATIC positioning statement (no rotating reel) that leads with
// the proven SWE track record, threads applied AI as the current direction in
// the subtext, and shows the proof as an editorial track-record strip.
//
// The signature device is the "working in the open" BUILD LOG panel in the
// right column (desktop): a monospace, "as of"-dated, in-progress log naming
// Ship Pipeline, ts-pmo, and /ratify. It replaces the arcade CRT used by the
// other two attempts, and it is on-thesis: the through-line of the applied-AI
// work is keeping a human accountable for what ships, so the site presents that
// work as an honest, logged, in-progress record rather than a finished product.
//
// Behind everything sits the same self-animating "constellation" lattice (canvas
// dot grid lit by roaming energy centers + the cursor) as ambient texture, plus
// a soft purple bloom. Honors prefers-reduced-motion. See the "Interactive
// lattice" + "Build-log panel" overrides in CLAUDE.md.
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';

// Proven SWE track record, shown as an editorial stat strip. All figures are
// verified facts already stated elsewhere on the site; no invented metrics.
const trackRecord = [
  { figure: '16,000+', label: 'vulnerabilities cleared' },
  { figure: '300K+', label: 'Kafka msgs a day on AWS' },
  { figure: '7 yrs', label: 'shipping software end-to-end' },
];

// The applied-AI work, framed strictly in progress (honesty guardrails). Status
// stamps are counts / version labels, never invented performance metrics.
const buildLog = [
  {
    name: 'Ship Pipeline',
    status: 'building',
    desc: 'An idea through a staged ladder, every deliverable paired with a verifier. Run on 2 builds so far.',
  },
  {
    name: 'ts-pmo',
    status: 'v0 live',
    desc: 'Long-term project ops: effort to work-stream to task, with behavioral and outcome accountability.',
  },
  {
    name: '/ratify',
    status: 'instrument',
    desc: 'State your expectation before the AI reveal, then log it. The surprise rate is a comprehension signal.',
  },
];
---

<section class="hero">
  <div class="hero__bloom" aria-hidden="true"></div>
  <canvas class="hero__lattice" aria-hidden="true"></canvas>

  <div class="hero__content">
    <div class="hero__identity reveal" style="--reveal-delay: 80ms">
      <Image
        src={photo}
        alt="Noah Lee"
        width={128}
        height={128}
        loading="eager"
        class="hero__avatar"
      />
      <p class="hero__name">Noah Lee</p>
      <ul class="hero__roles">
        <li>Full-Stack Engineer</li>
        <li>Building Applied AI</li>
      </ul>
    </div>

    <h1 class="hero__headline reveal" style="--reveal-delay: 160ms">
      Seven years shipping and securing<br />
      software <em class="serif-italic">end to end.</em>
    </h1>

    <p class="hero__sub reveal" style="--reveal-delay: 260ms">
      AWS, security at scale, ex-United Airlines.
      <strong>My current work is applied AI: systems that keep a human accountable
      for what ships.</strong>
    </p>

    <dl class="hero__stats reveal" style="--reveal-delay: 340ms">
      {trackRecord.map((s) => (
        <div class="hero__stat">
          <dt class="hero__stat-figure">{s.figure}</dt>
          <dd class="hero__stat-label">{s.label}</dd>
        </div>
      ))}
    </dl>

    <div class="hero__status reveal" style="--reveal-delay: 420ms">
      <span class="hero__status-dot" aria-hidden="true"></span>
      <span class="hero__status-text">
        <strong>Open to work</strong> · software &amp; applied-AI roles · Chicago, remote-open
      </span>
    </div>

    <div class="hero__cta-row reveal" style="--reveal-delay: 500ms">
      <a href="#contact" class="hero__cta hero__cta--primary">Get in touch</a>
      <a href="#now" class="hero__cta hero__cta--secondary">
        See what I'm building
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Build-log panel: the hero's right-column anchor on desktop. Hidden on
       mobile to keep the hero lean; the fuller "Now building" section below
       carries the same systems on small screens. -->
  <aside class="hero__log reveal" style="--reveal-delay: 560ms" aria-label="What I'm building now">
    <div class="buildlog">
      <div class="buildlog__bar">
        <span class="buildlog__path">~/now-building</span>
        <span class="buildlog__tag">log</span>
      </div>
      <div class="buildlog__body">
        <p class="buildlog__meta">In progress · as of July 2026</p>
        <ul class="buildlog__list">
          {buildLog.map((item) => (
            <li class="buildlog__item">
              <div class="buildlog__head">
                <span class="buildlog__name">{item.name}</span>
                <span class="buildlog__status">{item.status}</span>
              </div>
              <p class="buildlog__desc">{item.desc}</p>
            </li>
          ))}
        </ul>
        <p class="buildlog__foot">
          A fuller case study and a <span class="buildlog__route">/ledger</span> view are in progress.
        </p>
      </div>
    </div>
  </aside>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: 100%;
    min-height: 100dvh;
    background: var(--color-paper);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 2.5rem;
    padding: calc(var(--nav-height) + 3rem) 1.5rem 3rem;
  }

  /* ── Interactive lattice backdrop (ambient texture) ── */
  .hero__lattice {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Soft purple light pool that tracks the eased focus point. color-mix keeps
     the accent on the --color-rust token rather than a hardcoded value. */
  .hero__bloom {
    position: absolute;
    top: 0;
    left: 0;
    width: 28rem;
    height: 28rem;
    margin: -14rem 0 0 -14rem;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-rust) 10%, transparent),
      transparent 68%
    );
    filter: blur(30px);
    pointer-events: none;
    will-change: transform;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 48rem;
    min-width: 0;
  }

  /* ── Identity block: face + big name + role labels, so "who is this" is instant.
     Role labels stack vertically to the right of the name, divided by a hairline
     (an editorial nameplate). The first role is the proven identity and carries
     the accent; the second is the threaded current direction, phrased as an
     activity in progress rather than a claimed specialist title. ── */
  .hero__identity {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    min-width: 0;
  }

  .hero__avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 2px solid var(--color-rule);
    flex-shrink: 0;
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }

  .hero__roles {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-rule);
    min-width: 0;
  }

  .hero__roles li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* The first role is the proven credential; tint it the accent. */
  .hero__roles li:first-child {
    color: var(--color-rust);
  }

  /* ── Static headline ── */
  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 5.25rem);
    line-height: 1.0;
    letter-spacing: 0;
    color: var(--color-ink);
    text-transform: none;
    text-wrap: balance;
  }

  .hero__headline .serif-italic {
    color: var(--color-rust);
    /* serif descenders need a hair of room at line-height 1.0 */
    padding-bottom: 0.04em;
  }

  /* ── Subtext ── */
  .hero__sub {
    font-family: var(--font-body);
    font-size: var(--font-size-sub);
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 36rem;
  }

  .hero__sub strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  /* ── Track-record stat strip ── */
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem 2.25rem;
    align-items: flex-end;
    margin: 0;
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .hero__stat-figure {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }

  .hero__stat-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* ── Open-to-work status pill ── */
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    align-self: flex-start;
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    line-height: 1.4;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-paper-soft) 78%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.5rem 0.9375rem;
  }

  .hero__status-text {
    min-width: 0;
  }

  .hero__status strong {
    color: var(--color-rust);
    font-weight: 600;
  }

  .hero__status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-rust);
    flex-shrink: 0;
  }

  .hero__status-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-rust);
    animation: status-pulse 2.4s ease-out infinite;
  }

  @keyframes status-pulse {
    0%        { transform: scale(1); opacity: 0.5; }
    70%, 100% { transform: scale(3); opacity: 0; }
  }

  /* ── CTAs ── */
  .hero__cta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.25rem;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.875rem 1.5rem;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
    min-height: 44px;
  }

  .hero__cta:active { transform: scale(0.97); }

  .hero__cta:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: 3px;
  }

  .hero__cta--primary {
    background: var(--color-rust);
    color: var(--color-paper);
    border: 1px solid var(--color-rust);
  }

  .hero__cta--primary:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }

  .hero__cta--secondary {
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    background: transparent;
  }

  .hero__cta--secondary:hover {
    color: var(--color-rust);
    border-color: var(--color-rust);
  }

  /* ── Build-log panel (desktop right column; hidden on mobile) ── */
  .hero__log {
    position: relative;
    z-index: 2;
    display: none;
    width: 100%;
    min-width: 0;
  }

  .buildlog {
    background: color-mix(in srgb, var(--color-paper-soft) 82%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--color-rule);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 60px -30px color-mix(in srgb, var(--color-paper) 85%, transparent);
  }

  .buildlog__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.125rem;
    border-bottom: 1px solid var(--color-rule);
    background: color-mix(in srgb, var(--color-paper) 40%, transparent);
  }

  .buildlog__path {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }

  .buildlog__tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-rust);
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    padding: 0.15rem 0.45rem;
  }

  .buildlog__body {
    padding: 1.25rem 1.25rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .buildlog__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .buildlog__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .buildlog__item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-rule);
    min-width: 0;
  }

  .buildlog__item:first-child {
    padding-top: 0;
    border-top: none;
  }

  .buildlog__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }

  .buildlog__name {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    min-width: 0;
  }

  .buildlog__status {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-rust);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .buildlog__desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .buildlog__foot {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-rule);
  }

  .buildlog__route {
    color: var(--color-rust);
  }

  /* ── Desktop: split into content (left) + build-log (right) ── */
  @media (min-width: 1024px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 40rem) 24rem;
      justify-content: center;
      align-items: center;
      gap: 3.5rem;
      padding: calc(var(--nav-height) + 4rem) 4rem 5rem;
    }

    .hero__content {
      max-width: 40rem;
      gap: 1.75rem;
    }

    .hero__log { display: block; }
  }

  @media (min-width: 1280px) {
    .hero { grid-template-columns: minmax(0, 40rem) 26rem; padding-inline: 5rem; }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      min-height: 92dvh;
      padding: calc(var(--nav-height) + 3rem) 1.5rem 3rem;
    }

    .hero__content { gap: 1.25rem; }

    .hero__roles {
      flex-basis: 100%;
      padding-left: 0;
      border-left: none;
    }

    .hero__sub {
      font-size: 1rem;
      line-height: 1.6;
    }
  }

  @media (max-width: 480px) {
    .hero { padding: calc(var(--nav-height) + 2.5rem) 1.25rem 2.5rem; }
    .hero__avatar { width: 56px; height: 56px; }
    .hero__name { font-size: 2.25rem; }
    .hero__stats { gap: 1.25rem 1.75rem; }
  }
</style>

<script>
  // ── Interactive lattice backdrop (ambient texture) ──
  // A self-animating "constellation": a canvas dot grid lit by a few soft energy
  // centers that roam on their own paths (so the field is alive even when the
  // cursor is still), with the cursor as the primary, strongest center on top,
  // plus a faint per-node twinkle and a soft purple bloom. Honors
  // prefers-reduced-motion (renders a single static frame, no loop).
  const hero = document.querySelector<HTMLElement>('.hero');
  const canvas = document.querySelector<HTMLCanvasElement>('.hero__lattice');
  const bloom = document.querySelector<HTMLElement>('.hero__bloom');
  const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Read brand colors from the CSS tokens so the canvas stays single-sourced.
  const readRGB = (name: string, fallback: [number, number, number]): [number, number, number] => {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const m = /^#?([0-9a-fA-F]{6})$/.exec(v);
    if (!m) return fallback;
    const n = parseInt(m[1], 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  };

  if (hero && canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const PURPLE = readRGB('--color-rust', [155, 109, 255]);
      const BASE = readRGB('--color-ink-muted', [138, 132, 128]);
      const PURPLE_RGB = `${PURPLE[0]},${PURPLE[1]},${PURPLE[2]}`;

      let dpr = 1, W = 0, H = 0, gap = 46, cols = 0;
      let xs = new Float32Array(0);
      let ys = new Float32Array(0);
      let ease = new Float32Array(0);
      let dx = new Float32Array(0);
      let dy = new Float32Array(0);
      let phase = new Float32Array(0); // per-node twinkle offset (golden-angle scatter)

      const tgt = { x: 0, y: 0 };
      const eye = { x: 0, y: 0 };
      let pointerActive = false;
      let lastMove = -1e9;
      let raf = 0;
      let onscreen = true;
      let inited = false;

      const measure = () => {
        const r = hero.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        W = Math.max(1, Math.round(r.width * dpr));
        H = Math.max(1, Math.round(r.height * dpr));
        canvas.width = W;
        canvas.height = H;
        gap = (r.width < 640 ? 34 : 46) * dpr;
        cols = Math.max(1, Math.floor(W / gap));
        const rows = Math.max(1, Math.floor(H / gap));
        const mx = (W - (cols - 1) * gap) / 2;
        const my = (H - (rows - 1) * gap) / 2;
        const n = cols * rows;
        xs = new Float32Array(n);
        ys = new Float32Array(n);
        ease = new Float32Array(n);
        dx = new Float32Array(n);
        dy = new Float32Array(n);
        phase = new Float32Array(n);
        let k = 0;
        for (let rr = 0; rr < rows; rr++) {
          for (let c = 0; c < cols; c++) {
            xs[k] = mx + c * gap;
            ys[k] = my + rr * gap;
            phase[k] = (k * 2.399963) % 6.283185; // golden-angle scatter, deterministic
            k++;
          }
        }
        if (!inited) {
          eye.x = tgt.x = W * 0.32;
          eye.y = tgt.y = H * 0.52;
          inited = true;
        }
      };

      const render = (time: number, animate: boolean) => {
        if (animate && (!pointerActive || time - lastMove > 2600)) {
          pointerActive = false;
          const t = time * 0.00014;
          tgt.x = W * (0.40 + 0.26 * Math.cos(t));
          tgt.y = H * (0.48 + 0.30 * Math.sin(t * 1.25));
        }
        if (animate) {
          eye.x += (tgt.x - eye.x) * 0.05;
          eye.y += (tgt.y - eye.y) * 0.05;
        } else {
          eye.x = tgt.x;
          eye.y = tgt.y;
        }

        const small = W / dpr < 640;
        const Rc = (small ? 150 : 220) * dpr; // cursor / primary spotlight
        const Ra = (small ? 118 : 176) * dpr; // ambient roaming centers
        const base = 1.3 * dpr;
        const n = xs.length;

        // Ambient "constellation" centers roam on their own Lissajous paths every
        // frame, independent of the cursor, so the field stays alive at rest. The
        // cursor (eye) is the primary, strongest center on top of them.
        const at = time * 0.0002;
        const a1x = W * (0.62 + 0.26 * Math.cos(at * 0.70 + 1.3));
        const a1y = H * (0.34 + 0.32 * Math.sin(at * 0.90 + 0.5));
        const a2x = W * (0.30 + 0.30 * Math.cos(at * 1.05 + 4.2));
        const a2y = H * (0.64 + 0.26 * Math.sin(at * 0.80 + 2.1));

        // [center] = cursor, ambient-1, ambient-2
        const cx = [eye.x, a1x, a2x];
        const cy = [eye.y, a1y, a2y];
        const cR = [Rc, Ra, Ra];
        const cPull = [4.0, 2.6, 2.6];
        const cGlow = [1.0, 0.78, 0.78];
        const NC = 3;

        // Slow global twinkle so even the dark field between centers shimmers
        // faintly rather than reading as flat black.
        const tw = time * 0.0011;

        ctx.clearRect(0, 0, W, H);

        // Nodes: faint twinkling grid everywhere, gathered + lit toward purple
        // inside any center's reach (contributions from all centers accumulate).
        for (let i = 0; i < n; i++) {
          let lit = 0;
          let mx2 = 0;
          let my2 = 0;
          for (let c = 0; c < NC; c++) {
            const ox = xs[i] - cx[c];
            const oy = ys[i] - cy[c];
            const R = cR[c];
            const d2 = ox * ox + oy * oy;
            if (d2 < R * R) {
              const d = Math.sqrt(d2) || 0.0001;
              const e = 1 - d / R;
              const ee = e * e;
              lit += ee * cGlow[c];
              const pull = (ee * cPull[c] * dpr) / d;
              mx2 -= ox * pull;
              my2 -= oy * pull;
            }
          }
          if (lit > 1) lit = 1;
          ease[i] = lit;
          const X = xs[i] + mx2;
          const Y = ys[i] + my2;
          dx[i] = X;
          dy[i] = Y;

          const shimmer = 0.5 + 0.5 * Math.sin(tw + phase[i]);
          const a = 0.06 + 0.03 * shimmer + lit * 0.42;
          const cr = (BASE[0] + (PURPLE[0] - BASE[0]) * lit) | 0;
          const cg = (BASE[1] + (PURPLE[1] - BASE[1]) * lit) | 0;
          const cb = (BASE[2] + (PURPLE[2] - BASE[2]) * lit) | 0;
          const s = base + lit * 1.6 * dpr;
          ctx.fillStyle = `rgba(${cr},${cg},${cb},${a})`;
          ctx.fillRect(X - s / 2, Y - s / 2, s, s);
        }

        // Links: only between lit neighbours, faint, so the lattice softly "wires up".
        ctx.lineWidth = dpr;
        for (let i = 0; i < n; i++) {
          const ei = ease[i];
          if (ei <= 0) continue;
          if (i % cols < cols - 1) {
            const j = i + 1;
            if (ease[j] > 0) {
              ctx.strokeStyle = `rgba(${PURPLE_RGB},${Math.min(ei, ease[j]) * 0.32})`;
              ctx.beginPath();
              ctx.moveTo(dx[i], dy[i]);
              ctx.lineTo(dx[j], dy[j]);
              ctx.stroke();
            }
          }
          const k = i + cols;
          if (k < n && ease[k] > 0) {
            ctx.strokeStyle = `rgba(${PURPLE_RGB},${Math.min(ei, ease[k]) * 0.32})`;
            ctx.beginPath();
            ctx.moveTo(dx[i], dy[i]);
            ctx.lineTo(dx[k], dy[k]);
            ctx.stroke();
          }
        }

        if (bloom) {
          bloom.style.transform = `translate(${eye.x / dpr}px, ${eye.y / dpr}px)`;
        }

        if (animate) raf = requestAnimationFrame((t) => render(t, true));
      };

      const start = () => {
        if (!raf) raf = requestAnimationFrame((t) => render(t, true));
      };
      const stop = () => {
        if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      };

      hero.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'touch') return; // let the idle auto-roam handle touch
        const r = hero.getBoundingClientRect();
        tgt.x = (e.clientX - r.left) * dpr;
        tgt.y = (e.clientY - r.top) * dpr;
        pointerActive = true;
        lastMove = performance.now();
      });
      hero.addEventListener('pointerleave', () => {
        pointerActive = false;
      });

      let resizeT = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeT);
        resizeT = window.setTimeout(() => {
          measure();
          if (reduceMq.matches || !onscreen) render(0, false);
        }, 150);
      });

      measure();

      if (reduceMq.matches) {
        render(0, false); // single static frame, no loop
      } else {
        render(0, false); // paint once immediately so it's there before rAF settles
        const io = new IntersectionObserver(
          (entries) => {
            onscreen = entries[0].isIntersecting;
            if (onscreen && !document.hidden) start();
            else stop();
          },
          { threshold: 0 }
        );
        io.observe(hero);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stop();
          else if (onscreen) start();
        });
      }
    }
  }
</script>
