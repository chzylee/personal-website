---
// The hero leads with a rotating "reel" of practices Noah brings to a team.
// Each line: a serif-italic purple verb (the brand collision) + Bebas display rest.
// Items stack in one grid cell so the headline height never jumps between swaps.
//
// On desktop, the right column holds a retro CRT "screen" (HeroScreen) that runs
// a slideshow of career highlights, navigable by buttons / arrow keys / a game
// controller. Behind everything sits a self-animating "constellation": a canvas
// dot grid lit by a few soft energy centers that roam on their own paths (so the
// field is alive even when the cursor is still), with the cursor as the primary,
// strongest center on top, plus a faint per-node twinkle and a soft purple bloom.
// Honors prefers-reduced-motion. See the "Interactive lattice" + "Hero CRT
// screen" overrides in CLAUDE.md.
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
import HeroScreen from './HeroScreen.astro';

const reel = [
  { verb: 'Securing', rest: ' the path to production.' },
  { verb: 'Getting', rest: ' separate teams to ship together.' },
  { verb: 'Training', rest: ' engineers for ownership.' },
  { verb: 'Owning', rest: ' every change AI writes.' },
  { verb: 'Designing', rest: ' directly with customers.' },
];

const reelLabel =
  'What I bring to a team: securing the path to production; getting separate teams to ship together; ' +
  'training engineers to own their work; owning every change AI writes; designing directly with customers.';
---

<section class="hero">
  <div class="hero__bloom" aria-hidden="true"></div>
  <canvas class="hero__lattice" aria-hidden="true"></canvas>

  <div class="hero__content">
    <div class="hero__identity reveal" style="--reveal-delay: 80ms">
      <Image
        src={photo}
        alt="Noah Lee"
        width={128}
        height={128}
        loading="eager"
        class="hero__avatar"
      />
      <p class="hero__name">Noah Lee</p>
      <ul class="hero__roles">
        <li>Full-Stack Engineer</li>
        <li>Building Applied AI</li>
      </ul>
    </div>

    <h1 class="hero__headline reveal" style="--reveal-delay: 160ms" aria-label={reelLabel}>
      <span class="hero__reel">
        {reel.map((item, i) => (
          <span class={`hero__reel-item${i === 0 ? ' is-active' : ''}`} aria-hidden="true">
            <em class="hero__reel-verb">{item.verb}</em><br />{item.rest}
          </span>
        ))}
      </span>
    </h1>

    <p class="hero__sub reveal" style="--reveal-delay: 280ms">
      Seven years shipping software end-to-end: AWS, security at scale, ex-United Airlines.<br />
      <strong>Current work: applied AI systems that keep a human accountable for what ships.</strong>
    </p>

    <div class="hero__status reveal" style="--reveal-delay: 360ms">
      <span class="hero__status-dot" aria-hidden="true"></span>
      <span class="hero__status-text">
        <strong>Open to work</strong> · software &amp; applied-AI roles · Chicago, remote-open
      </span>
    </div>

    <div class="hero__cta-row reveal" style="--reveal-delay: 440ms">
      <a href="#contact" class="hero__cta hero__cta--primary">Get in touch</a>
      <a href="#work" class="hero__cta hero__cta--secondary">
        See the work
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="hero__screen reveal" style="--reveal-delay: 520ms">
    <p class="hero__controller-hint" aria-hidden="true">Plug in your controller</p>
    <HeroScreen />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: 100%;
    min-height: 100dvh;
    background: var(--color-paper);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 2.5rem;
    padding: calc(var(--nav-height) + 3rem) 1.5rem 3rem;
  }

  /* ── Interactive lattice backdrop (toned-down ambient texture) ── */
  .hero__lattice {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Soft purple light pool that tracks the eased focus point. color-mix keeps
     the accent on the --color-rust token rather than a hardcoded value. */
  .hero__bloom {
    position: absolute;
    top: 0;
    left: 0;
    width: 28rem;
    height: 28rem;
    margin: -14rem 0 0 -14rem;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-rust) 10%, transparent),
      transparent 68%
    );
    filter: blur(30px);
    pointer-events: none;
    will-change: transform;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 48rem;
    min-width: 0;
  }

  /* ── Identity block: face + big name + role labels, so "who is this" is instant.
     The name is short, so it's set large for impact, but capped under the reel's
     scale so the value-prop headline stays the biggest moment. Role labels stack
     vertically to the right of the name, divided by a hairline (an editorial
     nameplate, not floating corner text). ── */
  .hero__identity {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    min-width: 0;
  }

  .hero__avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 2px solid var(--color-rule);
    flex-shrink: 0;
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }

  .hero__roles {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-rule);
  }

  .hero__roles li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* The first role is the headline credential; tint it the accent. */
  .hero__roles li:first-child {
    color: var(--color-rust);
  }

  /* ── Rotating headline reel ── */
  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 5.25rem);
    line-height: 1.0;
    letter-spacing: 0;
    color: var(--color-ink);
    text-transform: none;
    text-wrap: balance;
  }

  /* All items share one grid cell, so the box is as tall as the tallest line
     and swapping never reflows the page. */
  .hero__reel {
    display: grid;
  }

  .hero__reel-item {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.4em);
    transition:
      opacity 0.5s ease,
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .hero__reel-item.is-active {
    opacity: 1;
    transform: none;
  }

  /* Item exits upward — opposite of the enter-from-below entrance */
  .hero__reel-item.is-exiting {
    opacity: 0;
    transform: translateY(-0.35em);
  }

  .hero__reel-verb {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--color-rust);
    /* serif descenders (Getting / Engineering / Designing) need a hair of room */
    padding-bottom: 0.04em;
  }

  /* ── Subtext ── */
  .hero__sub {
    font-family: var(--font-body);
    font-size: var(--font-size-sub);
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 36rem;
  }

  .hero__sub strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  /* ── Open-to-work status pill ── */
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    align-self: flex-start;
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    line-height: 1.4;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-paper-soft) 78%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.5rem 0.9375rem;
  }

  .hero__status-text {
    min-width: 0;
  }

  .hero__status strong {
    color: var(--color-rust);
    font-weight: 600;
  }

  .hero__status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-rust);
    flex-shrink: 0;
  }

  .hero__status-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-rust);
    animation: status-pulse 2.4s ease-out infinite;
  }

  @keyframes status-pulse {
    0%        { transform: scale(1); opacity: 0.5; }
    70%, 100% { transform: scale(3); opacity: 0; }
  }

  /* ── CTAs ── */
  .hero__cta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.25rem;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.875rem 1.5rem;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
    min-height: 44px;
  }

  .hero__cta:active { transform: scale(0.97); }

  .hero__cta:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: 3px;
  }

  .hero__cta--primary {
    background: var(--color-rust);
    color: var(--color-paper);
    border: 1px solid var(--color-rust);
  }

  .hero__cta--primary:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }

  .hero__cta--secondary {
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    background: transparent;
  }

  .hero__cta--secondary:hover {
    color: var(--color-rust);
    border-color: var(--color-rust);
  }

  /* ── CRT screen slot (desktop only; mobile keeps the hero lean) ── */
  .hero__screen {
    position: relative;
    z-index: 2;
    display: none;
    width: 100%;
  }

  /* Hidden "plug in your controller" hint above the CRT. Invisible at rest; the
     lattice script raises its opacity as the cursor-light passes near it, so you
     only find it by dragging across the grid. */
  .hero__controller-hint {
    position: absolute;
    bottom: 100%;
    left: 0;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-rust);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
  }

  /* ── Desktop: split into content (left) + screen (right) ── */
  @media (min-width: 1024px) {
    .hero {
      display: grid;
      /* Content-sized tracks + justify-content:center keeps the column cluster
         together and centered on ultra-wide viewports, instead of a greedy 1fr
         flinging the content and CRT to opposite walls with a dead band between.
         The hero stays full-bleed (so the lattice/bloom still cover the viewport
         and track the cursor everywhere); only the cluster is centered. The left
         track shrinks below 40rem on narrow desktops, so no overflow. */
      grid-template-columns: minmax(0, 40rem) 26rem;
      justify-content: center;
      align-items: center;
      gap: 3.5rem;
      padding: calc(var(--nav-height) + 4rem) 4rem 5rem;
    }

    .hero__content {
      max-width: 40rem;
      gap: 1.75rem;
    }

    .hero__screen { display: block; }
  }

  @media (min-width: 1280px) {
    .hero { grid-template-columns: minmax(0, 40rem) 28rem; padding-inline: 5rem; }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      min-height: 92dvh;
      padding: calc(var(--nav-height) + 3rem) 1.5rem 3rem;
    }

    .hero__content { gap: 1.25rem; }

    .hero__roles {
      flex-basis: 100%;
      padding-left: 0;
      border-left: none;
    }

    .hero__sub {
      font-size: 1rem;
      line-height: 1.6;
    }
  }

  @media (max-width: 480px) {
    .hero { padding: calc(var(--nav-height) + 2.5rem) 1.25rem 2.5rem; }
    .hero__avatar { width: 56px; height: 56px; }
    .hero__name { font-size: 2.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__reel-item {
      transition: none;
    }
  }
</style>

<script>
  // ── Rotating headline reel ──
  // Progressive enhancement: item 0 is already `.is-active` in the HTML, so
  // without JS (or under reduced motion) the hero shows a complete first line.
  // First swap fires at ~1.2s (inside the 5-second scan window) so the signature
  // motion proves itself before a recruiter scrolls; then a steady cadence.
  const reel = document.querySelector<HTMLElement>('.hero__reel');
  const reelReduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (reel && !reelReduce.matches) {
    const items = Array.from(reel.querySelectorAll<HTMLElement>('.hero__reel-item'));
    if (items.length > 1) {
      let i = 0;
      const advance = () => {
        const current = items[i];
        i = (i + 1) % items.length;
        const next = items[i];
        current.classList.add('is-exiting');
        current.classList.remove('is-active');
        next.classList.add('is-active');
        setTimeout(() => current.classList.remove('is-exiting'), 750);
      };
      window.setTimeout(() => {
        advance();
        window.setInterval(advance, 3200);
      }, 1200);
    }
  }

  // ── Interactive lattice backdrop (toned-down ambient texture) ──
  const hero = document.querySelector<HTMLElement>('.hero');
  const canvas = document.querySelector<HTMLCanvasElement>('.hero__lattice');
  const bloom = document.querySelector<HTMLElement>('.hero__bloom');
  const hint = document.querySelector<HTMLElement>('.hero__controller-hint');
  const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Read brand colors from the CSS tokens so the canvas stays single-sourced.
  const readRGB = (name: string, fallback: [number, number, number]): [number, number, number] => {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const m = /^#?([0-9a-fA-F]{6})$/.exec(v);
    if (!m) return fallback;
    const n = parseInt(m[1], 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  };

  if (hero && canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const PURPLE = readRGB('--color-rust', [155, 109, 255]);
      const BASE = readRGB('--color-ink-muted', [138, 132, 128]);
      const PURPLE_RGB = `${PURPLE[0]},${PURPLE[1]},${PURPLE[2]}`;

      let dpr = 1, W = 0, H = 0, gap = 46, cols = 0;
      let xs = new Float32Array(0);
      let ys = new Float32Array(0);
      let ease = new Float32Array(0);
      let dx = new Float32Array(0);
      let dy = new Float32Array(0);
      let phase = new Float32Array(0); // per-node twinkle offset (golden-angle scatter)

      const tgt = { x: 0, y: 0 };
      const eye = { x: 0, y: 0 };
      let pointerActive = false;
      let lastMove = -1e9;
      let raf = 0;
      let onscreen = true;
      let inited = false;
      let hintCx = -1, hintCy = -1; // hint center in CSS px, relative to the hero

      const measure = () => {
        const r = hero.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        W = Math.max(1, Math.round(r.width * dpr));
        H = Math.max(1, Math.round(r.height * dpr));
        canvas.width = W;
        canvas.height = H;
        gap = (r.width < 640 ? 34 : 46) * dpr;
        cols = Math.max(1, Math.floor(W / gap));
        const rows = Math.max(1, Math.floor(H / gap));
        const mx = (W - (cols - 1) * gap) / 2;
        const my = (H - (rows - 1) * gap) / 2;
        const n = cols * rows;
        xs = new Float32Array(n);
        ys = new Float32Array(n);
        ease = new Float32Array(n);
        dx = new Float32Array(n);
        dy = new Float32Array(n);
        phase = new Float32Array(n);
        let k = 0;
        for (let rr = 0; rr < rows; rr++) {
          for (let c = 0; c < cols; c++) {
            xs[k] = mx + c * gap;
            ys[k] = my + rr * gap;
            phase[k] = (k * 2.399963) % 6.283185; // golden-angle scatter, deterministic
            k++;
          }
        }
        if (!inited) {
          eye.x = tgt.x = W * 0.32;
          eye.y = tgt.y = H * 0.52;
          inited = true;
        }

        // Locate the hidden "plug in your controller" hint so the render loop can
        // reveal it by proximity. Skipped when it's display:none (mobile).
        if (hint && hint.offsetParent !== null) {
          const hr = hint.getBoundingClientRect();
          hintCx = hr.left - r.left + hr.width / 2;
          hintCy = hr.top - r.top + hr.height / 2;
        } else {
          hintCx = -1;
        }
      };

      const render = (time: number, animate: boolean) => {
        if (animate && (!pointerActive || time - lastMove > 2600)) {
          pointerActive = false;
          const t = time * 0.00014;
          tgt.x = W * (0.40 + 0.26 * Math.cos(t));
          tgt.y = H * (0.48 + 0.30 * Math.sin(t * 1.25));
        }
        if (animate) {
          eye.x += (tgt.x - eye.x) * 0.05;
          eye.y += (tgt.y - eye.y) * 0.05;
        } else {
          eye.x = tgt.x;
          eye.y = tgt.y;
        }

        const small = W / dpr < 640;
        const Rc = (small ? 150 : 220) * dpr; // cursor / primary spotlight
        const Ra = (small ? 118 : 176) * dpr; // ambient roaming centers
        const base = 1.3 * dpr;
        const n = xs.length;

        // Ambient "constellation" centers roam on their own Lissajous paths every
        // frame, independent of the cursor, so the field stays alive at rest. The
        // cursor (eye) is the primary, strongest center on top of them.
        const at = time * 0.0002;
        const a1x = W * (0.62 + 0.26 * Math.cos(at * 0.70 + 1.3));
        const a1y = H * (0.34 + 0.32 * Math.sin(at * 0.90 + 0.5));
        const a2x = W * (0.30 + 0.30 * Math.cos(at * 1.05 + 4.2));
        const a2y = H * (0.64 + 0.26 * Math.sin(at * 0.80 + 2.1));

        // [center] = cursor, ambient-1, ambient-2
        const cx = [eye.x, a1x, a2x];
        const cy = [eye.y, a1y, a2y];
        const cR = [Rc, Ra, Ra];
        const cPull = [4.0, 2.6, 2.6];
        const cGlow = [1.0, 0.78, 0.78];
        const NC = 3;

        // Slow global twinkle so even the dark field between centers shimmers
        // faintly rather than reading as flat black.
        const tw = time * 0.0011;

        ctx.clearRect(0, 0, W, H);

        // Nodes: faint twinkling grid everywhere, gathered + lit toward purple
        // inside any center's reach (contributions from all centers accumulate).
        for (let i = 0; i < n; i++) {
          let lit = 0;
          let mx2 = 0;
          let my2 = 0;
          for (let c = 0; c < NC; c++) {
            const ox = xs[i] - cx[c];
            const oy = ys[i] - cy[c];
            const R = cR[c];
            const d2 = ox * ox + oy * oy;
            if (d2 < R * R) {
              const d = Math.sqrt(d2) || 0.0001;
              const e = 1 - d / R;
              const ee = e * e;
              lit += ee * cGlow[c];
              const pull = (ee * cPull[c] * dpr) / d;
              mx2 -= ox * pull;
              my2 -= oy * pull;
            }
          }
          if (lit > 1) lit = 1;
          ease[i] = lit;
          const X = xs[i] + mx2;
          const Y = ys[i] + my2;
          dx[i] = X;
          dy[i] = Y;

          const shimmer = 0.5 + 0.5 * Math.sin(tw + phase[i]);
          const a = 0.06 + 0.03 * shimmer + lit * 0.42;
          const cr = (BASE[0] + (PURPLE[0] - BASE[0]) * lit) | 0;
          const cg = (BASE[1] + (PURPLE[1] - BASE[1]) * lit) | 0;
          const cb = (BASE[2] + (PURPLE[2] - BASE[2]) * lit) | 0;
          const s = base + lit * 1.6 * dpr;
          ctx.fillStyle = `rgba(${cr},${cg},${cb},${a})`;
          ctx.fillRect(X - s / 2, Y - s / 2, s, s);
        }

        // Links: only between lit neighbours, faint, so the lattice softly "wires up".
        ctx.lineWidth = dpr;
        for (let i = 0; i < n; i++) {
          const ei = ease[i];
          if (ei <= 0) continue;
          if (i % cols < cols - 1) {
            const j = i + 1;
            if (ease[j] > 0) {
              ctx.strokeStyle = `rgba(${PURPLE_RGB},${Math.min(ei, ease[j]) * 0.32})`;
              ctx.beginPath();
              ctx.moveTo(dx[i], dy[i]);
              ctx.lineTo(dx[j], dy[j]);
              ctx.stroke();
            }
          }
          const k = i + cols;
          if (k < n && ease[k] > 0) {
            ctx.strokeStyle = `rgba(${PURPLE_RGB},${Math.min(ei, ease[k]) * 0.32})`;
            ctx.beginPath();
            ctx.moveTo(dx[i], dy[i]);
            ctx.lineTo(dx[k], dy[k]);
            ctx.stroke();
          }
        }

        if (bloom) {
          bloom.style.transform = `translate(${eye.x / dpr}px, ${eye.y / dpr}px)`;
        }

        // Reveal the controller hint as the cursor-light nears it.
        if (hint && hintCx >= 0) {
          const hd = Math.hypot(eye.x / dpr - hintCx, eye.y / dpr - hintCy);
          hint.style.opacity = Math.max(0, Math.min(1, 1.15 - hd / 170)).toFixed(3);
        }

        if (animate) raf = requestAnimationFrame((t) => render(t, true));
      };

      const start = () => {
        if (!raf) raf = requestAnimationFrame((t) => render(t, true));
      };
      const stop = () => {
        if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      };

      hero.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'touch') return; // let the idle auto-roam handle touch
        const r = hero.getBoundingClientRect();
        tgt.x = (e.clientX - r.left) * dpr;
        tgt.y = (e.clientY - r.top) * dpr;
        pointerActive = true;
        lastMove = performance.now();
      });
      hero.addEventListener('pointerleave', () => {
        pointerActive = false;
      });

      let resizeT = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeT);
        resizeT = window.setTimeout(() => {
          measure();
          if (reduceMq.matches || !onscreen) render(0, false);
        }, 150);
      });

      measure();

      // The hero grid centers its column cluster, so the CRT (and the hint
      // anchored to it) settle into final position only after late layout shifts
      // (web fonts, CRT content). Re-measure then, or the hint's captured center
      // goes stale and it reveals when the cursor-light is nowhere near it.
      const remeasure = () => {
        measure();
        if (reduceMq.matches || !onscreen) render(0, false);
      };
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(remeasure);
      }
      window.addEventListener('load', remeasure);

      if (reduceMq.matches) {
        render(0, false); // single static frame, no loop
      } else {
        render(0, false); // paint once immediately so it's there before rAF settles
        const io = new IntersectionObserver(
          (entries) => {
            onscreen = entries[0].isIntersecting;
            if (onscreen && !document.hidden) start();
            else stop();
          },
          { threshold: 0 }
        );
        io.observe(hero);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stop();
          else if (onscreen) start();
        });
      }
    }
  }
</script>
