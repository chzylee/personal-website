---
import { Image } from 'astro:assets';

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const photos = Object.values(photoModules).map((m) => m.default).slice(0, 5);
const totalSeconds = photos.length * 8;
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    {photos.map((photo, i) => (
      <Image
        src={photo}
        alt=""
        width={1920}
        height={1280}
        class="hero__photo"
        loading={i === 0 ? 'eager' : 'lazy'}
        style={`animation-duration:${totalSeconds}s;animation-delay:${i * 8}s`}
      />
    ))}
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__content">
    <span class="eyebrow hero__eyebrow">Engineer &amp; community architect</span>

    <h1 class="hero__headline">
      <span class="hero__headline-display">I build systems for</span>
      <span class="hero__headline-serif">people.</span>
    </h1>

    <p class="hero__sub">
      Backend engineer, <strong>7 seven years on AWS</strong>, small teams to large. Lately: shipping
      full-stack apps end-to-end and running events in the Melty Blood community as
      it's grown from ~60 to 200+ players.
    </p>

    <div class="hero__cta-row">
      <a href="#contact" class="hero__cta hero__cta--primary">Get in touch</a>
      <a href="#work" class="hero__cta hero__cta--secondary">
        See the work
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    background: var(--color-paper);
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: calc(var(--nav-height) + 3rem) 2.5rem 5rem 4rem;
  }

  /* ── Full-bleed photo background ── */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  @keyframes hero-slide {
    0%     { opacity: 0; transform: scale(1.04); }
    3.75%  { opacity: 1; }
    16.25% { opacity: 1; transform: scale(1); }
    20%    { opacity: 0; transform: scale(1); }
    100%   { opacity: 0; }
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: contrast(0.92) saturate(0.85) brightness(0.85);
    opacity: 0;
    animation: hero-slide linear infinite;
    animation-fill-mode: both;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(14, 13, 11, 0.85) 0%,
        rgba(14, 13, 11, 0.55) 50%,
        rgba(14, 13, 11, 0.35) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(14, 13, 11, 0.4) 0%,
        rgba(14, 13, 11, 0.15) 30%,
        rgba(14, 13, 11, 0.55) 100%
      );
    pointer-events: none;
  }

  /* ── Content overlay ── */
  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 42rem;
    min-width: 0;
  }

  .hero__eyebrow {
    color: var(--color-rust);
    font-size: 0.875rem;
    text-shadow:
      0 2px 16px rgba(0, 0, 0, 0.9),
      0 0 40px rgba(0, 0, 0, 0.7);
  }

  /* ── Headline (cinematic shadow) ── */
  .hero__headline {
    font-family: var(--font-display);
    font-size: var(--font-size-headline);
    line-height: 0.95;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    text-transform: none;
    text-shadow:
      0 4px 32px rgba(0, 0, 0, 0.9),
      0 2px 12px rgba(0, 0, 0, 0.75),
      0 0 80px rgba(0, 0, 0, 0.5);
  }

  .hero__headline-display {
    display: block;
  }

  .hero__headline-serif {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-rust);
    font-size: 0.95em;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-top: 0.05em;
    font-weight: 400;
    text-shadow:
      0 4px 32px rgba(0, 0, 0, 0.85),
      0 2px 12px rgba(0, 0, 0, 0.7);
  }

  /* ── Subtext ── */
  .hero__sub {
    font-family: var(--font-body);
    font-size: var(--font-size-sub);
    line-height: 1.55;
    color: var(--color-ink);
    max-width: 36rem;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.85);
  }

  .hero__sub strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  /* ── CTAs ── */
  .hero__cta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.875rem 1.5rem;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    min-height: 44px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .hero__cta--primary {
    background: var(--color-rust);
    color: var(--color-paper);
    border: 1px solid var(--color-rust);
  }

  .hero__cta--primary:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }

  .hero__cta--secondary {
    color: var(--color-ink);
    border: 1px solid var(--color-ink);
    background: rgba(14, 13, 11, 0.35);
  }

  .hero__cta--secondary:hover {
    color: var(--color-rust);
    border-color: var(--color-rust);
  }

  /* ── Mobile (≤ 768px) ── */
  @media (max-width: 768px) {
    .hero {
      min-height: 90dvh;
      padding: calc(var(--nav-height) + 2rem) 1.5rem 3rem;
      align-items: flex-end;
    }

    .hero__scrim {
      background:
        linear-gradient(
          to bottom,
          rgba(14, 13, 11, 0.55) 0%,
          rgba(14, 13, 11, 0.4) 30%,
          rgba(14, 13, 11, 0.85) 100%
        );
    }

    .hero__content { gap: 1.5rem; }

    .hero__sub {
      font-size: 1rem;
      line-height: 1.6;
    }
  }

  @media (max-width: 480px) {
    .hero { padding: calc(var(--nav-height) + 1.5rem) 1.25rem 2.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__photo {
      animation: none;
      opacity: 0;
    }
    .hero__photo:first-of-type {
      opacity: 1;
    }
  }
</style>
