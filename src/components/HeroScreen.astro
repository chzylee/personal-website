---
// A retro CRT / arcade "screen" running a short reel of what Noah is up to:
// the latest In Your Corner letter (fetched at build time), what he's building
// in public, FindMyFGC for the scene, and (last) a playable YouTube embed of
// the newest video from his Melty Blood event-series playlist. The TV is the
// personal surface of the site, not a stats board.
//
// Navigable by the on-screen arrows, the keyboard (← →), and a game controller
// (Gamepad API) as an easter egg, including fight-stick POV-hat axes (e.g. a
// HORI stick reports direction on axis 9, not the d-pad buttons). Decorative
// chrome is aria-hidden; slide content is exposed to AT via an aria-live
// region; inactive slides are `inert` so their links never catch focus.
// Honors prefers-reduced-motion (no auto-advance/flicker; manual nav works).
import { substackLatest, playlistLatest, PLAYLIST_ID } from '../data/tv';

interface Slide {
  /** Small mono channel label. */
  tag: string;
  title: string;
  context: string;
  /** Where the slide's CTA link goes (non-video slides). */
  href?: string;
  cta?: string;
  /** Optional still image. Placement set by `media`. */
  image?: string | null;
  /** Portrait variant, swapped in on mobile where the still becomes a strip. */
  imagePortrait?: string | null;
  /** Still layout: 'top' (default, landscape band above text) or 'right'
      (portrait strip beside the text). */
  media?: 'top' | 'right';
  /** The video slide renders a click-to-load YouTube facade instead. */
  video?: boolean;
}

const slides: Slide[] = [
  {
    tag: 'In Your Corner',
    title: substackLatest.title,
    context: 'The latest letter from my Substack.',
    href: substackLatest.url,
    cta: 'Read it',
    image: substackLatest.image,
    imagePortrait: substackLatest.imagePortrait,
  },
  {
    tag: 'Now building',
    title: 'skill-library',
    context: 'Claude Code skills in my workflow: use what you like or install the whole plugin.',
    href: 'https://github.com/chzylee/skill-library',
    cta: 'Browse the repo',
  },
  {
    tag: 'For the scene',
    title: 'FindMyFGC',
    context: 'Find fighting game events near you wherever you are.',
    href: 'https://www.findmyfgc.cc/',
    cta: 'Find your next event',
    image: '/find-my-fgc-map.png',
    media: 'right',
  },
  {
    tag: 'Melt Your Blood',
    title: 'Latest from my event series',
    context: 'For players ascending toward top-level play.',
    video: true,
  },
];

const total = slides.length;
const totalLabel = String(total).padStart(2, '0');
const videoThumb = `https://i.ytimg.com/vi/${playlistLatest.videoId}/hqdefault.jpg`;
---

<section
  class="crt"
  role="group"
  aria-roledescription="carousel"
  aria-label="Now showing"
>
  <div class="crt__bezel">
    <div class="crt__screen">
      <div class="crt__topbar" aria-hidden="true">
        <span class="crt__frame">
          <svg class="crt__tv-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="15" x="2" y="7" rx="2"/>
            <path d="m17 2-5 5-5-5"/>
          </svg>
          NOW SHOWING
        </span>
        <span class="crt__stagenum"><span data-stage-current>01</span> / {totalLabel}</span>
      </div>

      <div class="crt__stage">
        {slides.map((s, i) => (
          <article
            class={`crt__slide${i === 0 ? ' is-active' : ''}${s.video ? ' crt__slide--video' : ''}${s.image ? ' crt__slide--has-media' : ''}${s.media === 'right' ? ' crt__slide--media-right' : ''}`}
            data-slide={i}
            data-label={`${s.tag}. ${s.title}. ${s.context}`}
            aria-hidden={i !== 0 ? 'true' : 'false'}
            inert={i !== 0}
          >
            {s.video ? (
              <div
                class="crt__video"
                data-video-slot
                data-video={playlistLatest.videoId}
                data-list={PLAYLIST_ID}
              >
                <img class="crt__video-thumb" src={videoThumb} alt="" width="480" height="360" loading="lazy" decoding="async" />
                <span class="crt__video-tag">{s.tag}</span>
                <button class="crt__video-play" type="button" data-video-play>
                  <span class="crt__video-play-ring" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M8 5.14v14l11-7-11-7z"/>
                    </svg>
                  </span>
                  Press play
                </button>
              </div>
            ) : (
              <>
                {s.image && (
                  <span class="crt__still">
                    <picture>
                      {s.imagePortrait && (
                        <source media="(max-width: 1023px)" srcset={s.imagePortrait} />
                      )}
                      <img src={s.image} alt="" width="480" height="270" loading="lazy" decoding="async" />
                    </picture>
                  </span>
                )}
                <span class="crt__cat">{s.tag}</span>
                <span class="crt__title">{s.title}</span>
                <span class="crt__context">{s.context}</span>
                {s.href && s.cta && (
                  <a class="crt__cta" href={s.href} target="_blank" rel="noopener noreferrer">
                    {s.cta}
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                    </svg>
                  </a>
                )}
              </>
            )}
          </article>
        ))}
      </div>

      <div class="crt__hud" aria-hidden="true">
        <span class="crt__p1">P1</span>
        <span class="crt__player">NOAH</span>
      </div>

      <div class="crt__scanlines" aria-hidden="true"></div>
      <div class="crt__vignette" aria-hidden="true"></div>
      <div class="crt__glass" aria-hidden="true"></div>
    </div>
  </div>

  <div class="crt__controls">
    <button class="crt__btn" type="button" data-prev aria-label="Previous slide">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>

    <div class="crt__dots" role="tablist" aria-label="Slides">
      {slides.map((_, i) => (
        <button
          class={`crt__dot${i === 0 ? ' is-active' : ''}`}
          type="button"
          data-dot={i}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`Slide ${i + 1} of ${total}`}
        ></button>
      ))}
    </div>

    <button class="crt__btn" type="button" data-next aria-label="Next slide">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>

    <span class="crt__hint" aria-hidden="true">
      <span class="crt__keys">&larr; &rarr;</span>
      <svg class="crt__pad" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="6" y1="11" x2="10" y2="11"/><line x1="8" y1="9" x2="8" y2="13"/>
        <line x1="15" y1="12" x2="15.01" y2="12"/><line x1="18" y1="10" x2="18.01" y2="10"/>
        <rect x="2" y="6" width="20" height="12" rx="6"/>
      </svg>
    </span>
  </div>

  <p class="crt__live" aria-live="polite" aria-atomic="true"></p>
</section>

<style>
  .crt {
    /* Strong ease-out for the small UI moves (Emil: built-in eases are weak). */
    --crt-ease: cubic-bezier(0.23, 1, 0.32, 1);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    width: 100%;
    min-width: 0;
  }

  /* ── Cabinet bezel ── */
  .crt__bezel {
    padding: 0.85rem;
    border-radius: 16px;
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--color-paper-soft) 88%, var(--color-ink) 5%),
        var(--color-paper)
      );
    border: 1px solid var(--color-rule);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 60%, transparent),
      0 24px 60px -28px color-mix(in srgb, var(--color-rust) 40%, transparent);
  }

  /* ── Screen ── */
  .crt__screen {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 9px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.4rem;
    padding: 0.85rem 1rem;
    background:
      radial-gradient(
        130% 120% at 50% 0%,
        color-mix(in srgb, var(--color-rust) 7%, var(--color-paper)),
        var(--color-paper) 70%
      );
    box-shadow:
      inset 0 0 50px color-mix(in srgb, var(--color-paper) 92%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--color-rust) 12%, transparent);
    animation: crt-flicker 6s steps(60) infinite;
  }

  @keyframes crt-flicker {
    0%, 100% { opacity: 1; }
    47%      { opacity: 0.99; }
    48%      { opacity: 0.96; }
    49%      { opacity: 1; }
    72%      { opacity: 0.985; }
  }

  /* Scanlines + vignette + screen-glass highlight, all non-interactive overlays */
  .crt__scanlines,
  .crt__vignette,
  .crt__glass {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border-radius: 9px;
  }

  .crt__scanlines {
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper) 70%, transparent) 0 1px,
      transparent 1px 3px
    );
    opacity: 0.5;
    mix-blend-mode: multiply;
    transition: opacity 0.3s ease;
  }

  /* Ease off the CRT chrome while a video is actually playing. */
  .crt.is-playing .crt__scanlines { opacity: 0.12; }
  .crt.is-playing .crt__vignette { opacity: 0.3; }

  .crt__vignette {
    background: radial-gradient(
      120% 100% at 50% 45%,
      transparent 55%,
      color-mix(in srgb, var(--color-paper) 85%, transparent) 100%
    );
    transition: opacity 0.3s ease;
  }

  .crt__glass {
    background: linear-gradient(
      125deg,
      color-mix(in srgb, var(--color-ink) 6%, transparent) 0%,
      transparent 28%
    );
  }

  /* ── Top bar (channel framing) ── */
  .crt__topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
  }

  .crt__frame {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-rust);
  }

  .crt__tv-icon { color: var(--color-rust); }

  .crt__stagenum { color: var(--color-ink-muted); }
  .crt__stagenum [data-stage-current] { color: var(--color-ink); }

  /* ── Slides ── */
  .crt__stage {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  /* Crossfade with a touch of blur (Emil: blur bridges a crossfade so the eye
     reads one channel-change, not two overlapping states). */
  .crt__slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    min-width: 0;
    opacity: 0;
    filter: blur(4px);
    transition: opacity 0.4s ease, filter 0.4s ease;
  }

  .crt__slide.is-active {
    opacity: 1;
    filter: blur(0);
  }

  /* Inactive slides must never catch the pointer (their links sit above the
     stage) — `inert` handles focus/AT, this handles hover. */
  .crt__slide[inert] { pointer-events: none; }

  .crt__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-rust);
  }

  .crt__cat::before {
    content: "";
    width: 14px;
    height: 1px;
    background: var(--color-rust);
  }

  .crt__title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.8vw, 1.75rem);
    line-height: 1.02;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    text-shadow: 0 0 20px color-mix(in srgb, var(--color-rust) 30%, transparent);
  }

  .crt__context {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--color-ink-muted);
  }

  /* ── Still image (broadcast frame above the text) ── */
  .crt__still {
    display: block;
    flex: 0 1 46%;
    min-height: 0;
    margin-bottom: 0.45rem;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-rule);
  }

  /* <picture> is art direction only; let the <img> take the sizing rules. */
  .crt__still picture { display: contents; }

  .crt__still img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── media: 'right' — a portrait still as a full-height strip on the right,
     text flowing on the left (contrast to the default top-band still). ── */
  .crt__slide--media-right {
    padding-right: 42%;
  }

  .crt__slide--media-right .crt__still {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 38%;
    height: auto;
    flex: none;
    margin: 0;
  }

  /* On the narrow mobile screen a top band letterboxes into a sliver, so every
     still moves to the same right-hand strip the map slide uses: image and text
     split the width instead of stacking. The <picture> above swaps in a
     portrait crop to match. */
  @media (max-width: 1023px) {
    .crt__slide--has-media { padding-right: 42%; }

    .crt__slide--has-media .crt__still {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 38%;
      height: auto;
      flex: none;
      margin: 0;
    }
  }

  /* ── Slide CTA ── */
  .crt__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    margin-top: 0.35rem;
    padding: 0.35rem 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-rust);
    border-bottom: 1px solid color-mix(in srgb, var(--color-rust) 45%, transparent);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .crt__cta:hover {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .crt__cta:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: 3px;
  }

  /* ── Video slide: click-to-load YouTube facade ── */
  .crt__slide--video { justify-content: stretch; }

  .crt__video {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
  }

  .crt__video-thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }

  .crt__video-tag {
    position: absolute;
    left: 0.65rem;
    bottom: 0.55rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-paper) 78%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .crt__video-play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-shadow: 0 1px 8px color-mix(in srgb, var(--color-paper) 80%, transparent);
    background: radial-gradient(
      80% 80% at 50% 50%,
      color-mix(in srgb, var(--color-paper) 35%, transparent),
      transparent
    );
    transition: color 0.2s ease;
  }

  .crt__video-play-ring {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-brand) 90%, transparent);
    border: 1px solid var(--color-brand);
    transition: transform 0.25s var(--crt-ease), background 0.2s ease;
  }

  .crt__video-play-ring svg { margin-left: 3px; }

  .crt__video-play:hover .crt__video-play-ring {
    transform: scale(1.08);
    background: var(--color-brand);
  }

  .crt__video-play:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: -3px;
    border-radius: 6px;
  }

  :global(.crt__video-frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── Bottom HUD: P1 nameplate (lights when a controller connects) ── */
  .crt__hud {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
  }

  .crt__p1 {
    color: var(--color-ink-muted);
    border: 1px solid var(--color-rule);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .crt__player { color: var(--color-ink-muted); }

  .crt.is-pad .crt__p1 {
    background: var(--color-rust);
    border-color: var(--color-rust);
    color: var(--color-paper);
  }
  .crt.is-pad .crt__player { color: var(--color-ink); }

  /* ── Controls ── */
  .crt__controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .crt__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    color: var(--color-ink);
    background: var(--color-paper-soft);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.12s var(--crt-ease);
  }

  .crt__btn:active { transform: scale(0.94); }
  .crt__btn:focus-visible { outline: 2px solid var(--color-rust); outline-offset: 2px; }

  .crt__dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: auto;
  }

  .crt__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--color-ink-muted);
    background: transparent;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.25s var(--crt-ease);
  }

  .crt__dot.is-active {
    background: var(--color-rust);
    border-color: var(--color-rust);
    transform: scale(1.15);
  }
  .crt__dot:focus-visible { outline: 2px solid var(--color-rust); outline-offset: 2px; }

  .crt__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
  }

  .crt__pad {
    color: var(--color-ink-muted);
    transition: color 0.2s ease;
  }

  .crt.is-pad .crt__pad { color: var(--color-rust); }

  /* Hover states only where a real hover pointer exists (Emil: touch fires
     phantom hovers on tap). */
  @media (hover: hover) and (pointer: fine) {
    .crt__btn:hover { color: var(--color-rust); border-color: var(--color-rust); }
    .crt__dot:hover { border-color: var(--color-rust); }
  }

  /* Visually-hidden live region for screen readers */
  .crt__live {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // The CRT can render twice on the page: in the hero (desktop) and as a section
  // below the hero (mobile), with CSS showing exactly one at a time. Wire each
  // .crt instance independently, and let global keyboard/gamepad drive whichever
  // one is currently in view (the hidden one is display:none, so never intersects).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  type Crt = {
    prev: () => void;
    next: () => void;
    inView: () => boolean;
    setPad: (on: boolean) => void;
  };

  const initCrt = (root: HTMLElement): Crt | null => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.crt__slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.crt__dot'));
    const stageNum = root.querySelector<HTMLElement>('[data-stage-current]');
    const live = root.querySelector<HTMLElement>('.crt__live');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const videoSlot = root.querySelector<HTMLElement>('[data-video-slot]');
    const videoFacade = videoSlot?.innerHTML ?? '';
    const total = slides.length;
    if (total === 0) return null;

    let idx = 0;
    let timer = 0;
    let inView = true;
    let playing = false;

    const pad2 = (n: number) => String(n + 1).padStart(2, '0');

    // Loading the YouTube iframe is deferred until the visitor actually asks
    // for it, so the page never pays for YouTube's JS up front. Leaving the
    // slide tears the iframe down (audio must not keep playing off-screen)
    // and restores the facade.
    const startVideo = () => {
      if (!videoSlot || playing) return;
      const iframe = document.createElement('iframe');
      // Embed the specific (public) video and let &list continue into the
      // playlist. The bare /embed/videoseries?list= endpoint fails for unlisted
      // playlists ("An error occurred"), which this avoids.
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoSlot.dataset.video}?list=${videoSlot.dataset.list}&autoplay=1&rel=0`;
      iframe.title = 'Melty Blood event series archive';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'crt__video-frame';
      videoSlot.replaceChildren(iframe);
      playing = true;
      root.classList.add('is-playing');
      halt();
    };

    const stopVideo = () => {
      if (!videoSlot || !playing) return;
      videoSlot.innerHTML = videoFacade;
      wireVideo();
      playing = false;
      root.classList.remove('is-playing');
    };

    const wireVideo = () => {
      videoSlot
        ?.querySelector<HTMLButtonElement>('[data-video-play]')
        ?.addEventListener('click', startVideo);
    };
    wireVideo();

    const go = (n: number) => {
      const target = ((n % total) + total) % total;
      if (target === idx) return;
      if (playing) stopVideo();
      slides[idx].classList.remove('is-active');
      slides[idx].setAttribute('aria-hidden', 'true');
      slides[idx].toggleAttribute('inert', true);
      dots[idx].classList.remove('is-active');
      dots[idx].setAttribute('aria-selected', 'false');
      idx = target;
      slides[idx].classList.add('is-active');
      slides[idx].setAttribute('aria-hidden', 'false');
      slides[idx].toggleAttribute('inert', false);
      dots[idx].classList.add('is-active');
      dots[idx].setAttribute('aria-selected', 'true');
      if (stageNum) stageNum.textContent = pad2(idx);
      if (live) live.textContent = `Slide ${idx + 1} of ${total}: ${slides[idx].dataset.label ?? ''}`;
      restart();
    };

    const next = () => go(idx + 1);
    const prev = () => go(idx - 1);

    const restart = () => {
      if (reduce.matches || playing) return;
      window.clearInterval(timer);
      if (inView) timer = window.setInterval(next, 5000);
    };
    const halt = () => window.clearInterval(timer);

    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

    root.addEventListener('pointerenter', halt);
    root.addEventListener('pointerleave', restart);
    root.addEventListener('focusin', halt);
    root.addEventListener('focusout', restart);

    const io = new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        if (inView) restart();
        else {
          halt();
          // Off-screen video keeps playing audio otherwise.
          if (playing) stopVideo();
        }
      },
      { threshold: 0.25 }
    );
    io.observe(root);

    restart();

    return {
      prev,
      next,
      inView: () => inView,
      setPad: (on: boolean) => root.classList.toggle('is-pad', on),
    };
  };

  const instances = Array.from(document.querySelectorAll<HTMLElement>('.crt'))
    .map(initCrt)
    .filter((c): c is Crt => c !== null);

  if (instances.length) {
    // Drive whichever instance is currently visible.
    const active = () => instances.find((c) => c.inView()) ?? instances[0];

    // Keyboard: ← / → (these keys don't scroll the page).
    window.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement | null;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
      if (e.key === 'ArrowLeft') active().prev();
      else if (e.key === 'ArrowRight') active().next();
    });

    // ── Gamepad easter egg ──
    // Reads three direction sources: standard d-pad buttons (14/15), the left
    // analog stick (axis 0), and POV-hat axes. Fight sticks (e.g. HORI) encode
    // the stick as a hat on a high axis (axis 9) whose neutral sits OUTSIDE
    // [-1, 1] (~1.286), with 8 directions at -1, -0.71, -0.43, -0.14, 0.14,
    // 0.43, 0.71, 1.0. We auto-detect a hat by catching that out-of-range
    // neutral, then decode only those axes (so analog triggers, which rest at
    // -1, can never be mistaken for a direction).
    let padRAF = 0;
    const held = { left: false, right: false };
    const hatAxes = new Set<number>();
    const setPad = (on: boolean) => instances.forEach((c) => c.setPad(on));

    const pollPad = () => {
      const pads = navigator.getGamepads ? navigator.getGamepads() : [];
      let left = false, right = false;
      for (const gp of pads) {
        if (!gp) continue;
        if (gp.buttons[14]?.pressed) left = true;
        if (gp.buttons[15]?.pressed) right = true;
        const ax0 = gp.axes[0] ?? 0;
        if (ax0 < -0.55) left = true;
        if (ax0 > 0.55) right = true;
        for (let a = 0; a < gp.axes.length; a++) {
          const v = gp.axes[a];
          if (v == null || !Number.isFinite(v)) continue;
          if (v > 1.1) { hatAxes.add(a); continue; } // out-of-range neutral => it's a hat
          if (!hatAxes.has(a)) continue;             // only decode confirmed hats
          if (v > -0.95 && v < -0.05) right = true;   // E / NE / SE
          else if (v > 0.30 && v < 1.05) left = true; // W / NW / SW
        }
      }
      if (left && !held.left) active().prev();
      if (right && !held.right) active().next();
      held.left = left;
      held.right = right;
      padRAF = requestAnimationFrame(pollPad);
    };

    window.addEventListener('gamepadconnected', () => {
      setPad(true);
      if (!padRAF) padRAF = requestAnimationFrame(pollPad);
    });
    window.addEventListener('gamepaddisconnected', () => {
      const pads = navigator.getGamepads ? navigator.getGamepads() : [];
      if (!Array.from(pads).some(Boolean)) {
        setPad(false);
        if (padRAF) { cancelAnimationFrame(padRAF); padRAF = 0; }
      }
    });
  }
</script>
