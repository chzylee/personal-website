---
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
---

<header class="page-nav">
  <a href="/" class="page-nav__left" aria-label="Go to home">
    <Image
      src={photo}
      alt=""
      width={24}
      height={24}
      class="page-nav__photo"
      aria-hidden="true"
    />
    <span class="page-nav__name">Noah Lee</span>
  </a>

  <nav class="page-nav__links" aria-label="Site navigation">
    <a href="/work" class="page-nav__link">Work</a>
    <a href="/blog" class="page-nav__link">Writing</a>
    <a href="/#photography" class="page-nav__link">Photography</a>
    <a
      href="/NoahLeeResume.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="page-nav__link"
    >Resume</a>
  </nav>
</header>

<style>
  .page-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    padding: 0 2rem;
  }

  .page-nav__left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .page-nav__left:hover {
    opacity: 1;
  }

  .page-nav__photo {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
  }

  .page-nav__name {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .page-nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .page-nav__link {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text);
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .page-nav__link:hover {
    opacity: 1;
  }

</style>
