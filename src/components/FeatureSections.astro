---
import { Image } from 'astro:assets';
import type { ShowcaseItem } from '../data/types';

interface Props {
  items: ShowcaseItem[];
  /** Auto-advance interval in ms for multi-image carousels. 0 disables. */
  autoplayMs?: number;
}

const { items, autoplayMs = 5000 } = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/feature-graphics/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);

function resolveImage(file: string) {
  const entry = Object.entries(imageModules).find(([k]) => k.endsWith('/' + file));
  return entry ? entry[1].default : undefined;
}

function slidesFor(item: ShowcaseItem) {
  const files = item.imageFiles?.length
    ? item.imageFiles
    : item.imageFile
      ? [item.imageFile]
      : [];
  return files.map((file) => ({ file, img: resolveImage(file) }));
}
---

<div class="features">
  {items.map((feature, i) => {
    const slides = slidesFor(feature);
    const flip = i % 2 === 1;
    const isCarousel = slides.length > 1;
    return (
      <section class="feature" data-flip={flip ? '' : undefined}>
        <div class="feature__media">
          {slides.length === 0 ? (
            <div class="feature__placeholder" aria-hidden="true">
              <span class="feature__placeholder-label">{feature.label}</span>
              <span class="feature__placeholder-note">Graphic goes here</span>
            </div>
          ) : (
            <div
              class="carousel"
              data-carousel={isCarousel ? '' : undefined}
              data-autoplay={isCarousel ? autoplayMs : undefined}
            >
              <div class="carousel__viewport">
                {slides.map((slide, n) => (
                  <div class="carousel__slide" data-carousel-slide data-active={n === 0 ? '' : undefined}>
                    {slide.img ? (
                      <button
                        class="carousel__btn"
                        type="button"
                        data-lb-group={i}
                        data-lb-index={n}
                        aria-label="View full size"
                      >
                        <Image
                          src={slide.img}
                          alt={feature.imageAlt ?? ''}
                          width={1200}
                          height={900}
                          class="carousel__img"
                          loading="lazy"
                        />
                      </button>
                    ) : (
                      <div class="carousel__slide-placeholder">
                        <span class="feature__placeholder-label">{feature.label}</span>
                        <span class="feature__placeholder-file">{slide.file}</span>
                      </div>
                    )}
                  </div>
                ))}

                {isCarousel && (
                  <>
                    <button class="carousel__arrow carousel__arrow--prev" data-carousel-prev type="button" aria-label="Previous graphic">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m15 18-6-6 6-6"/>
                      </svg>
                    </button>
                    <button class="carousel__arrow carousel__arrow--next" data-carousel-next type="button" aria-label="Next graphic">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m9 18 6-6-6-6"/>
                      </svg>
                    </button>
                  </>
                )}
              </div>

              {isCarousel && (
                <div class="carousel__dots">
                  {slides.map((_, n) => (
                    <button class="carousel__dot" data-carousel-dot type="button" data-active={n === 0 ? '' : undefined} aria-label={`Show graphic ${n + 1}`}>
                      <span class="carousel__dot-mark"></span>
                    </button>
                  ))}
                </div>
              )}
            </div>
          )}
          {feature.photoCredit && (
            <p class="feature__photo-credit">
              <a href={feature.photoCredit.url} target="_blank" rel="noopener noreferrer">
                {feature.photoCredit.label}
              </a>
            </p>
          )}
        </div>

        <div class="feature__text">
          <span class="eyebrow eyebrow--rust">{feature.label}</span>
          <h3 class="feature__title">{feature.title}</h3>
          {feature.meta && <p class="feature__meta">{feature.meta}</p>}
          <p class="feature__body">{feature.body}</p>
          {feature.bodyExtra && <p class="feature__body">{feature.bodyExtra}</p>}
          {feature.link && (
            <a
              href={feature.link.url}
              class="feature__link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {feature.link.label}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              </svg>
            </a>
          )}
        </div>
      </section>
    );
  })}
</div>

<!-- Lightbox (shared across all features on this page) -->
<div class="lb" id="feature-lb" aria-modal="true" aria-label="Image viewer" role="dialog" hidden>
  <button class="lb__backdrop" data-lb-close aria-label="Close"></button>

  <button class="lb__arrow lb__arrow--prev" data-lb-prev aria-label="Previous image">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 18l-6-6 6-6"/>
    </svg>
  </button>

  <div class="lb__img-wrap">
    <img class="lb__img" id="lb-img" src="" alt="" />
  </div>

  <button class="lb__arrow lb__arrow--next" data-lb-next aria-label="Next image">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 18l6-6-6-6"/>
    </svg>
  </button>

  <button class="lb__close" data-lb-close aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    </svg>
  </button>
</div>

<script>
  function initCarousel(root: HTMLElement) {
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>('[data-carousel-slide]')
    );
    const total = slides.length;
    if (total <= 1) return;

    const dots = Array.from(
      root.querySelectorAll<HTMLElement>('[data-carousel-dot]')
    );
    let index = 0;

    function show(next: number) {
      index = (next + total) % total;
      slides.forEach((slide, n) =>
        slide.toggleAttribute('data-active', n === index)
      );
      dots.forEach((dot, n) => dot.toggleAttribute('data-active', n === index));
    }

    dots.forEach((dot, n) =>
      dot.addEventListener('click', () => {
        show(n);
        restart();
      })
    );

    const interval = Number(root.dataset.autoplay) || 0;
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    let timer: number | undefined;

    function start() {
      if (interval && !reduceMotion && timer === undefined) {
        timer = window.setInterval(() => show(index + 1), interval);
      }
    }
    function stop() {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    }
    function restart() {
      stop();
      start();
    }

    root
      .querySelector('[data-carousel-prev]')
      ?.addEventListener('click', () => {
        show(index - 1);
        restart();
      });
    root
      .querySelector('[data-carousel-next]')
      ?.addEventListener('click', () => {
        show(index + 1);
        restart();
      });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () =>
      document.hidden ? stop() : start()
    );

    start();
  }

  document
    .querySelectorAll<HTMLElement>('[data-carousel]')
    .forEach(initCarousel);

  // ── Lightbox ────────────────────────────────────────────────────
  const lb     = document.getElementById('feature-lb') as HTMLElement;
  const lbImg  = document.getElementById('lb-img') as HTMLImageElement;

  // Group buttons by feature index: Map<groupId, HTMLButtonElement[]>
  const groups = new Map<string, HTMLButtonElement[]>();
  document.querySelectorAll<HTMLButtonElement>('[data-lb-group]').forEach((btn) => {
    const g = btn.dataset.lbGroup!;
    if (!groups.has(g)) groups.set(g, []);
    groups.get(g)!.push(btn);
  });

  let activeGroup: HTMLButtonElement[] = [];
  let activeIndex = 0;

  function lbShow(index: number) {
    activeIndex = (index + activeGroup.length) % activeGroup.length;
    lbImg.src = activeGroup[activeIndex].querySelector('img')!.src;
    lbImg.alt = activeGroup[activeIndex].querySelector('img')!.alt;
    // Show/hide arrows only when multiple images in group
    const arrows = lb.querySelectorAll<HTMLElement>('[data-lb-prev],[data-lb-next]');
    arrows.forEach((a) => {
      a.style.display = activeGroup.length > 1 ? '' : 'none';
    });
  }

  function lbOpen(group: HTMLButtonElement[], index: number) {
    activeGroup = group;
    lbShow(index);
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    lb.querySelector<HTMLButtonElement>('[data-lb-close]')?.focus();
  }

  function lbClose() {
    lb.hidden = true;
    document.body.style.overflow = '';
  }

  groups.forEach((btns) => {
    btns.forEach((btn, n) => btn.addEventListener('click', () => lbOpen(btns, n)));
  });

  lb.querySelectorAll('[data-lb-close]').forEach((el) =>
    el.addEventListener('click', lbClose)
  );
  lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => lbShow(activeIndex - 1));
  lb.querySelector('[data-lb-next]')?.addEventListener('click', () => lbShow(activeIndex + 1));

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (lb.hidden) return;
    if (e.key === 'Escape')     lbClose();
    if (e.key === 'ArrowLeft')  lbShow(activeIndex - 1);
    if (e.key === 'ArrowRight') lbShow(activeIndex + 1);
  });
</script>

<style>
  .features {
    display: flex;
    flex-direction: column;
  }

  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding: 2rem 0;
    border-top: 1px solid var(--color-rule);
  }

  .feature:first-child {
    border-top: none;
    padding-top: 3rem;
  }

  /* Alternate: even rows put the graphic on the right. */
  .feature[data-flip] .feature__media { order: 2; }
  .feature[data-flip] .feature__text { order: 1; }

  /* ── Media ─────────────────────────────────────────────────────── */
  .feature__media {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .feature__placeholder {
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--color-paper-soft);
    border: 1px dashed var(--color-rule);
    border-radius: 6px;
    padding: 1.5rem;
    text-align: center;
  }

  .feature__placeholder-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-rust);
  }

  .feature__placeholder-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
  }

  .feature__placeholder-file {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-muted);
    opacity: 0.7;
  }

  /* ── Carousel ──────────────────────────────────────────────────── */
  .carousel {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .carousel__viewport {
    position: relative;
    background: var(--color-paper-soft);
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    overflow: hidden;
  }

  /* First slide is in flow and sets the frame height from the image's
     natural aspect ratio. Later slides stack on top absolutely. */
  .carousel__slide {
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .carousel__slide:not(:first-child) {
    position: absolute;
    inset: 0;
  }

  .carousel__slide[data-active] {
    opacity: 1;
    pointer-events: auto;
  }

  .carousel__btn {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: none;
    cursor: zoom-in;
  }

  .carousel__btn:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: 2px;
  }

  .carousel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  .carousel__btn:hover .carousel__img {
    opacity: 0.88;
  }

  .carousel__slide:first-child .carousel__img {
    height: auto;
  }

  .carousel__slide-placeholder {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.5rem;
    text-align: center;
  }

  .carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgba(14, 13, 11, 0.6);
    border: 1px solid var(--color-rule);
    color: var(--color-ink);
    cursor: pointer;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    z-index: 2;
  }

  .carousel__arrow:hover {
    color: var(--color-rust);
    border-color: var(--color-rust);
  }

  .carousel__arrow--prev { left: 0.75rem; }
  .carousel__arrow--next { right: 0.75rem; }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.875rem;
  }

  .carousel__dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  .carousel__dot-mark {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-ink-muted);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .carousel__dot:hover .carousel__dot-mark {
    background: var(--color-ink);
  }

  .carousel__dot[data-active] .carousel__dot-mark {
    background: var(--color-rust);
    transform: scale(1.25);
  }

  /* ── Photo credit ─────────────────────────────────────────────── */
  .feature__photo-credit {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
  }

  .feature__photo-credit a {
    color: inherit;
    transition: color 0.2s ease;
  }

  .feature__photo-credit a:hover {
    color: var(--color-rust);
  }

  /* ── Text ──────────────────────────────────────────────────────── */
  .feature__text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature__title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    line-height: 1.02;
    letter-spacing: 0.005em;
    color: var(--color-ink);
    font-weight: 400;
  }

  .feature__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-top: -0.5rem;
  }

  .feature__body {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
  }

  .feature__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color 0.2s ease;
    padding: 0.5rem 0;
    align-self: flex-start;
  }

  .feature__link:hover { color: var(--color-rust); }

  /* ── Mobile: stack, graphic always on top ─────────────────────── */
  @media (max-width: 768px) {
    .feature {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 3rem 0;
    }
    .feature:first-child { padding-top: 1.5rem; }
    .feature[data-flip] .feature__media { order: 0; }
    .feature[data-flip] .feature__text { order: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__slide { transition: none; }
    .carousel__img   { transition: none; }
  }

  /* ── Lightbox ─────────────────────────────────────────────────── */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lb[hidden] { display: none; }

  .lb__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(14, 13, 11, 0.92);
    border: none;
    cursor: default;
    padding: 0;
  }

  .lb__img-wrap {
    position: relative;
    z-index: 1;
    max-width: min(1200px, 92vw);
    max-height: 88dvh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lb__img {
    max-width: 100%;
    max-height: 88dvh;
    object-fit: contain;
    display: block;
    user-select: none;
  }

  .lb__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    color: var(--color-ink);
    opacity: 0.65;
    transition: opacity 0.2s ease, color 0.2s ease;
    padding: 1rem;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lb__arrow:hover { opacity: 1; color: var(--color-rust); }
  .lb__arrow--prev { left: 1rem; }
  .lb__arrow--next { right: 1rem; }

  .lb__close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 2;
    color: var(--color-ink);
    opacity: 0.65;
    transition: opacity 0.2s ease, color 0.2s ease;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lb__close:hover { opacity: 1; color: var(--color-rust); }
</style>
