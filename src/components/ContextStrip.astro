---
const cards = [
  {
    label: "Find the friction",
    body: "Walk through your workflow with me. The friction your team works around is where the missing tool lives. Adomin, FindMyFGC, and NEST all started exactly this way.",
  },
  {
    label: "Build it end-to-end",
    body: "Shipped to hold up in production. Seven years on AWS, most recently leading the on-prem to cloud migration and resolving 16,000+ CVEs at United Airlines. Four tools running for gaming organizers today.",
  },
  {
    label: "Lift the team behind it",
    body: "Beyond the build, the team running it grows stronger. Mentorship, leadership, and workflow design come with the engineering work.",
  },
];
---

<section class="value-section" aria-label="How I work">
  <div class="value-section__inner">
    <header class="value-section__header reveal">
      <span class="eyebrow">How I work</span>
      <h2 class="value-section__heading">
        From <em class="serif-italic">inside</em> the problem, out.
      </h2>
    </header>

    <div class="value-section__cards">
      {cards.map((card, i) => (
        <article class="value-card reveal" style={`--reveal-delay: ${i * 100}ms`}>
          <span class="value-card__index">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="value-card__label">{card.label}</h3>
          <p class="value-card__body">{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .value-section {
    padding: 6rem 2rem;
    background: var(--color-paper);
  }

  .value-section__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    min-width: 0;
  }

  .value-section__header {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 44rem;
  }

  .value-section__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    font-weight: 400;
  }

  .value-section__heading .serif-italic {
    color: var(--color-rust);
    font-size: 0.95em;
  }

  .value-section__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    background: var(--color-paper-soft);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .value-card:hover {
    border-color: var(--color-rust);
    transform: translateY(-2px);
  }

  .value-card__index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--color-rust);
  }

  .value-card__label {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--color-ink);
    font-weight: 400;
  }

  .value-card__body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  @media (max-width: 900px) {
    .value-section { padding: 4rem 1.5rem; }
    .value-section__inner { gap: 2.5rem; }
    .value-section__cards {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .value-section { padding: 3rem 1.25rem; }
    .value-card { padding: 1.75rem 1.5rem; }
  }
</style>
