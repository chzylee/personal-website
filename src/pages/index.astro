---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import StickyNav from '../components/StickyNav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Photography from '../components/Photography.astro';
import { projects } from '../data/projects';
import { communityProjects } from '../data/communityProjects';
import { getCollection } from 'astro:content';
import '../styles/global.css';

const iconModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/project-icons/**/*',
  { eager: true }
);
function resolveIcon(iconFile?: string) {
  if (!iconFile) return undefined;
  const entry = Object.entries(iconModules).find(([k]) => k.endsWith('/' + iconFile));
  return entry ? entry[1].default : undefined;
}
function slugify(title: string) {
  return title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const allPosts = await getCollection('writing', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featuredSoftware = projects.filter((p) =>
  ['FindMyFGC', 'adomi-san-bot'].includes(p.title)
);
const featuredCommunity = communityProjects.slice(0, 1);

const description =
  'Noah Lee: full-stack engineer (AWS, ex-United Airlines) building applied AI. Seven years shipping software end-to-end, including a 16,000+ vulnerability cross-team remediation and an AWS Lambda pipeline handling 300K+ Kafka messages a day. Current work is applied-AI systems that keep a human accountable for what ships (Ship Pipeline, ts-pmo, /ratify), framed as open experiments in progress. Open to software and applied-AI roles. Chicago, remote-open.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Noah Lee: Full-Stack Engineer, Building Applied AI" description={description} />
  </head>

  <body>
    <StickyNav />
    <Hero />
    <About />

    <!-- ── What I'm building now ─────────────────────────────────────────
         The substantive read of the applied-AI direction. The hero's build-log
         panel is the compact live tease (desktop) and is hidden on mobile, so
         this section carries the systems on every viewport. All copy obeys the
         applied-AI honesty rules in CLAUDE.md: in-progress, "as of"-dated, no
         trend claims, no invented metrics, vocabulary ceiling respected. -->
    <section id="now" class="now">
      <div class="now__inner">
        <header class="now__header reveal">
          <h2 class="now__heading">What I'm building now.</h2>
          <p class="now__stamp">In progress · as of July 2026</p>
        </header>

        <p class="now__intro reveal" style="--reveal-delay: 100ms">
          My track record is software engineering. My current work is applied AI:
          <strong>keeping a human accountable for what an AI actually ships.</strong>
          These are open experiments, not products. I run them on my own work and
          keep them honest by instrumenting them.
        </p>

        <ul class="now__list reveal" style="--reveal-delay: 160ms">
          <li class="now__item">
            <div class="now__item-head">
              <h3 class="now__item-name">Ship Pipeline</h3>
              <span class="now__item-status">building · 2 builds</span>
            </div>
            <p class="now__item-desc">
              An LLM-assisted development system: an idea moves through a staged
              ladder, and every deliverable is paired with a verifier so nothing
              advances unchecked. Run so far on two builds, Runway and Rotato.
            </p>
          </li>
          <li class="now__item">
            <div class="now__item-head">
              <h3 class="now__item-name">ts-pmo</h3>
              <span class="now__item-status">v0 live</span>
            </div>
            <p class="now__item-desc">
              Long-term project ops: effort → work-stream → task, tracked against
              both behavioral and outcome accountability. Daily work is captured
              through a debrief step into a Work Log.
            </p>
          </li>
        </ul>

        <p class="now__ratify reveal" style="--reveal-delay: 220ms">
          The through-line across both is <span class="now__route">/ratify</span>,
          a prediction-before-reveal ownership protocol: you state what you expect
          an AI change to be before you see it, then log whether you predicted it,
          were surprised, or had no opinion. The surprise rate becomes a
          comprehension signal, so the record shows a human stayed accountable
          rather than rubber-stamping. It is the protocol, the instrument, and a
          demo you can run on someone.
        </p>

        <p class="now__pointer reveal" style="--reveal-delay: 280ms">
          A fuller case study and a <span class="now__route">/ledger</span> view
          of the ratification log are in progress.
        </p>
      </div>
    </section>

    <!-- ── Selected work ─────────────────────────────────────────────── -->
    <section id="work" class="section">
      <div class="section__inner">
        <header class="section__header reveal">
          <span class="eyebrow">Selected work</span>
          <h2 class="section__heading">Things I've built and what changed.</h2>
        </header>

        <ul class="teaser-list">
          {featuredSoftware.map((p, i) => {
            const icon = resolveIcon(p.iconFile);
            return (
              <li class="teaser reveal" style={`--reveal-delay: ${i * 90}ms`}>
                <a href={`/work/${slugify(p.title)}`} class="teaser__link">
                  <div class="teaser__head">
                    {icon && (
                      <div class="teaser__icon">
                        <Image src={icon} alt="" width={40} height={40} class="teaser__icon-img" />
                      </div>
                    )}
                    <h3 class="teaser__title">{p.title}</h3>
                  </div>
                  <p class="teaser__one-line">{p.oneLine}</p>
                  <div class="teaser__tags">
                    {p.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                </a>
              </li>
            );
          })}

          {featuredCommunity.map((p, i) => {
            const icon = resolveIcon(p.iconFile);
            return (
              <li class="teaser reveal" style={`--reveal-delay: ${(featuredSoftware.length + i) * 90}ms`}>
                <a href={`/work/${p.slug}`} class="teaser__link">
                  <div class="teaser__head">
                    {icon && (
                      <div class="teaser__icon">
                        <Image src={icon} alt="" width={40} height={40} class="teaser__icon-img" />
                      </div>
                    )}
                    <h3 class="teaser__title">{p.title}</h3>
                  </div>
                  <p class="teaser__one-line">{p.oneLine}</p>
                  <div class="teaser__tags">
                    {p.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>

        <div class="section__footer">
          <a href="/work" class="more-link">
            All work
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href="/NoahLeeResume.pdf" target="_blank" rel="noopener noreferrer" class="more-link">
            Full resume
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ── Writing ───────────────────────────────────────────────────── -->
    <section id="writing" class="section section--alt">
      <div class="section__inner">
        <header class="section__header reveal">
          <span class="eyebrow">Writing</span>
          <h2 class="section__heading">Notes on development, growth, and mentality.</h2>
        </header>

        <ul class="post-list">
          {recentPosts.map((post, i) => {
            const date = post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            });
            return (
              <li class="post-item reveal" style={`--reveal-delay: ${i * 90}ms`}>
                <a href={`/blog/${post.slug}`} class="post-item__link">
                  <div class="post-item__row">
                    <h3 class="post-item__title">{post.data.title}</h3>
                    <time class="post-item__date" datetime={post.data.date.toISOString()}>{date}</time>
                  </div>
                  <p class="post-item__desc">{post.data.description}</p>
                </a>
              </li>
            );
          })}
        </ul>

        <div class="section__footer">
          <a href="/blog" class="more-link">
            All writing
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <Photography />

    <!-- ── Contact ───────────────────────────────────────────────────── -->
    <footer class="contact" id="contact">
      <div class="contact__inner">
        <p class="contact__lede reveal">
          Open to <em class="serif-italic">software & applied-AI</em> roles.
        </p>

        <p class="contact__status reveal" style="--reveal-delay: 120ms">
          Chicago, remote-open. I usually reply within a day.
        </p>

        <div class="contact__email-row reveal" style="--reveal-delay: 160ms">
          <a href="mailto:i.knowa.lee@gmail.com" class="contact__email">i.knowa.lee@gmail.com</a>
          <button class="contact__copy" type="button" data-copy-email="i.knowa.lee@gmail.com" aria-label="Copy email to clipboard">
            <span class="contact__copy-label">Copy</span>
          </button>
        </div>

        <div class="contact__actions reveal" style="--reveal-delay: 200ms">
          <a href="https://www.linkedin.com/in/noah-lee-dev/" target="_blank" rel="noopener noreferrer" class="contact__action">
            LinkedIn
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            </svg>
          </a>
          <a href="/NoahLeeResume.pdf" target="_blank" rel="noopener noreferrer" class="contact__action">
            Resume
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            </svg>
          </a>
        </div>

        <div class="contact__icons reveal" style="--reveal-delay: 280ms" role="list">
          <a href="https://github.com/chzylee" target="_blank" rel="noopener noreferrer" class="contact__icon-link" aria-label="GitHub" title="GitHub" role="listitem">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/noah-lee-dev/" target="_blank" rel="noopener noreferrer" class="contact__icon-link" aria-label="LinkedIn" title="LinkedIn" role="listitem">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/nav.ts';
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>

<style is:global>
  /* ── What I'm building now (applied-AI systems, honest + in-progress) ── */
  .now {
    padding: 6rem 2rem;
    background: var(--color-paper-soft);
    display: flex;
    justify-content: center;
    scroll-margin-top: var(--nav-height);
  }

  .now__inner {
    max-width: 44rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .now__header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .now__heading {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    font-weight: 400;
    text-wrap: balance;
  }

  .now__stamp {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .now__intro,
  .now__ratify,
  .now__pointer {
    font-family: var(--font-body);
    line-height: 1.7;
    color: var(--color-ink);
    max-width: 40rem;
  }

  .now__intro { font-size: 1.0625rem; }

  .now__intro strong { font-weight: 600; }

  .now__ratify {
    font-size: 1rem;
    color: var(--color-ink-muted);
  }

  .now__pointer {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .now__route { color: var(--color-rust); }

  .now__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    margin: 0.5rem 0;
  }

  .now__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-rule);
    min-width: 0;
  }

  .now__item:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .now__item-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    min-width: 0;
  }

  .now__item-name {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }

  .now__item-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-rust);
  }

  .now__item-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
    max-width: 40rem;
  }

  @media (max-width: 640px) {
    .now { padding: 4rem 1.5rem; }
  }

  @media (max-width: 480px) {
    .now { padding: 3.5rem 1.25rem; }
  }

  /* ── Shared section shell ─────────────────────────────────────────── */
  .section {
    padding: 6rem 2rem;
    background: var(--color-paper);
    display: flex;
    justify-content: center;
    scroll-margin-top: var(--nav-height);
  }

  .section--alt {
    background: var(--color-paper-soft);
  }

  .section__inner {
    max-width: 44rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    min-width: 0;
  }

  .section__header {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .section__heading {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    font-weight: 400;
    text-wrap: balance;
  }

  .section__footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color 0.2s ease;
    padding: 0.5rem 0;
  }

  .more-link:hover { color: var(--color-rust); }

  .more-link:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ── Teaser cards (selected work) ─────────────────────────────────── */
  .teaser-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .teaser {
    border-top: 1px solid var(--color-rule);
  }

  .teaser:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .teaser__link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem 0;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .teaser__link:hover { color: var(--color-rust); }

  .teaser__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .teaser__icon {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid var(--color-rule);
    flex-shrink: 0;
  }

  .teaser__icon-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .teaser__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1;
    letter-spacing: 0.005em;
    color: inherit;
    font-weight: 400;
  }

  .teaser__one-line {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink);
    max-width: 36rem;
  }

  .teaser__link:hover .teaser__one-line { color: var(--color-ink); }

  .teaser__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  /* ── Tag chip ─────────────────────────────────────────────────────── */
  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0;
    padding: 0.2em 0.55em;
    background: var(--color-paper-soft);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: 3px;
  }

  .section--alt .tag {
    background: var(--color-paper);
  }

  /* ── Writing list ─────────────────────────────────────────────────── */
  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-item {
    border-top: 1px solid var(--color-rule);
  }

  .post-item:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .post-item__link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 0;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .post-item__link:hover { color: var(--color-rust); }

  .post-item__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-item__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.1;
    letter-spacing: 0.005em;
    color: inherit;
    font-weight: 400;
  }

  .post-item__date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-item__desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* ── Contact footer ───────────────────────────────────────────────── */
  .contact {
    background: var(--color-paper-soft);
    color: var(--color-ink);
    padding: 6rem 2rem;
    display: flex;
    justify-content: center;
    scroll-margin-top: var(--nav-height);
  }

  .contact__inner {
    max-width: 44rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .contact__eyebrow {
    color: var(--color-rust);
  }

  .contact__lede {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    color: var(--color-ink);
    font-weight: 400;
  }

  .contact__lede .serif-italic {
    color: var(--color-rust);
    font-size: 0.95em;
  }

  .contact__status {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
  }

  .contact__email-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  .contact__email {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-rust);
    padding-bottom: 0.125rem;
    transition: color 0.2s ease;
    word-break: break-all;
  }

  .contact__email:hover { color: var(--color-rust); }

  .contact__copy {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-rust);
    color: var(--color-rust);
    background: transparent;
    transition: background 0.2s ease, color 0.2s ease;
    min-height: 44px;
  }

  .contact__copy:hover {
    background: var(--color-rust);
    color: var(--color-paper);
  }

  .contact__copy[data-copied="true"] {
    background: var(--color-rust);
    color: var(--color-paper);
  }

  .contact__copy:active { transform: translateY(1px); }

  .contact__copy:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: 2px;
  }

