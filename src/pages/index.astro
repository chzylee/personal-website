---
import StickyNav from '../components/StickyNav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import { projects } from '../data/projects';
import Photography from '../components/Photography.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Noah Lee — Community Builder, Platform Engineer, Backend Engineer" />
    <title>Noah Lee</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <StickyNav />
    <Hero />
    <About />

    <!-- ── Projects ──────────────────────────────────────────────────── -->
    <section id="projects" class="content-section">
      <div class="content-inner">
        <h2 class="section-label">Projects</h2>

        <ul class="project-list">
          {projects.map((p) => (
            <li class="project">
              <div class="project__header">
                <h3 class="project__title">{p.title}</h3>
                <div class="project__links">
                  <a
                    href={p.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project__link"
                    aria-label={`${p.title} on GitHub`}
                  >
                    <!-- Lucide: github -->
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                      <path d="M9 18c-4.51 2-5-2-7-2"/>
                    </svg>
                  </a>
                  {p.liveUrl && (
                    <a
                      href={p.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="project__link"
                      aria-label={`${p.title} live site`}
                    >
                      <!-- Lucide: external-link -->
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 3h6v6"/>
                        <path d="M10 14 21 3"/>
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
              <p class="project__desc">{p.description}</p>
              <div class="project__tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Photography />

    <!-- ── Contact ───────────────────────────────────────────────────── -->
    <footer class="contact">
      <a href="mailto:i.knowa.lee@gmail.com" class="contact__email">i.knowa.lee@gmail.com</a>
    </footer>

    <script>
      import '../scripts/nav.ts';
    </script>
  </body>
</html>

<style is:global>
  /* ── Shared section shell ─────────────────────────────────────────── */
  .content-section {
    padding: 5rem 2rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .content-section {
      padding: 3rem 1rem;
    }
  }

  .content-inner {
    max-width: 640px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ── Projects ─────────────────────────────────────────────────────── */
  .project-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .project {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project:first-child { padding-top: 0; }
  .project:last-child  { border-bottom: none; }

  .project__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.625rem;
  }

  .project__title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.3;
  }

  .project__links {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .project__link {
    color: var(--color-text);
    opacity: 0.35;
    transition: opacity 0.2s ease;
  }

  .project__link:hover { opacity: 1; }

  .project__desc {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 0.875rem;
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    font-size: 0.6875rem;
    font-family: monospace;
    letter-spacing: 0.04em;
    padding: 0.2em 0.6em;
    background: #181818;
    color: #666;
    border-radius: 3px;
  }

  /* ── Contact footer ───────────────────────────────────────────────── */
  .contact {
    padding: 3rem 2rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: center;
  }

  .contact__email {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .contact__email:hover {
    color: var(--color-text);
  }
</style>
