---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import StickyNav from '../components/StickyNav.astro';
import Hero from '../components/Hero.astro';
import ContextStrip from '../components/ContextStrip.astro';
import About from '../components/About.astro';
import Photography from '../components/Photography.astro';
import { projects } from '../data/projects';
import { communityProjects } from '../data/communityProjects';
import { getCollection } from 'astro:content';
import '../styles/global.css';

const iconModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/project-icons/**/*',
  { eager: true }
);
function resolveIcon(iconFile?: string) {
  if (!iconFile) return undefined;
  const entry = Object.entries(iconModules).find(([k]) => k.endsWith('/' + iconFile));
  return entry ? entry[1].default : undefined;
}
function slugify(title: string) {
  return title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const allPosts = await getCollection('writing', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featuredSoftware = projects.filter((p) =>
  ['FindMyFGC', 'adomi-san-bot'].includes(p.title)
);
const featuredCommunity = communityProjects.slice(0, 1);

const description =
  'Noah Lee — backend engineer and community architect. Cloud infrastructure at scale, FGC tools, and the scene I grew from under 100 to 200+ players at majors.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Noah Lee — I build systems for people." description={description} />
  </head>

  <body>
    <StickyNav />
    <Hero />
    <ContextStrip />
    <About />

    <!-- ── Selected work ─────────────────────────────────────────────── -->
    <section id="work" class="section">
      <div class="section__inner">
        <header class="section__header">
          <span class="eyebrow">Selected work</span>
          <h2 class="section__heading">Things I've built and what changed.</h2>
        </header>

        <ul class="teaser-list">
          {featuredSoftware.map((p) => {
            const icon = resolveIcon(p.iconFile);
            return (
              <li class="teaser">
                <a href={`/work/${slugify(p.title)}`} class="teaser__link">
                  <div class="teaser__head">
                    {icon && (
                      <div class="teaser__icon">
                        <Image src={icon} alt="" width={40} height={40} class="teaser__icon-img" />
                      </div>
                    )}
                    <h3 class="teaser__title">{p.title}</h3>
                  </div>
                  <p class="teaser__one-line">{p.oneLine}</p>
                  <div class="teaser__tags">
                    {p.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                </a>
              </li>
            );
          })}

          {featuredCommunity.map((p) => {
            const icon = resolveIcon(p.iconFile);
            return (
              <li class="teaser">
                <a href={`/work/${p.slug}`} class="teaser__link">
                  <div class="teaser__head">
                    {icon && (
                      <div class="teaser__icon">
                        <Image src={icon} alt="" width={40} height={40} class="teaser__icon-img" />
                      </div>
                    )}
                    <h3 class="teaser__title">{p.title}</h3>
                  </div>
                  <p class="teaser__one-line">{p.oneLine}</p>
                  <div class="teaser__tags">
                    {p.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>

        <div class="section__footer">
          <a href="/work" class="more-link">
            All work
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href="/NoahLeeResume.pdf" target="_blank" rel="noopener noreferrer" class="more-link">
            Full resume
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ── Writing ───────────────────────────────────────────────────── -->
    <section id="writing" class="section section--alt">
      <div class="section__inner">
        <header class="section__header">
          <span class="eyebrow">Writing</span>
          <h2 class="section__heading">Notes on development, growth, and mentality.</h2>
        </header>

        <ul class="post-list">
          {recentPosts.map((post) => {
            const date = post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            });
            return (
              <li class="post-item">
                <a href={`/blog/${post.slug}`} class="post-item__link">
                  <div class="post-item__row">
                    <h3 class="post-item__title">{post.data.title}</h3>
                    <time class="post-item__date" datetime={post.data.date.toISOString()}>{date}</time>
                  </div>
                  <p class="post-item__desc">{post.data.description}</p>
                </a>
              </li>
            );
          })}
        </ul>

        <div class="section__footer">
          <a href="/blog" class="more-link">
            All writing
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <Photography />

    <!-- ── Contact ───────────────────────────────────────────────────── -->
    <footer class="contact" id="contact">
      <div class="contact__inner">
        <span class="eyebrow contact__eyebrow">Get in touch</span>

        <p class="contact__lede">
          Open to <em class="serif-italic">freelance & full-time</em> work.
        </p>

        <div class="contact__email-row">
          <a href="mailto:i.knowa.lee@gmail.com" class="contact__email">i.knowa.lee@gmail.com</a>
          <button class="contact__copy" type="button" data-copy-email="i.knowa.lee@gmail.com" aria-label="Copy email to clipboard">
            <span class="contact__copy-label">Copy</span>
          </button>
        </div>

        <div class="contact__icons" role="list">
          <a href="https://github.com/chzylee" target="_blank" rel="noopener noreferrer" class="contact__icon-link" aria-label="GitHub (personal)" title="GitHub" role="listitem">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </a>
          <a href="https://github.com/enpicie" target="_blank" rel="noopener noreferrer" class="contact__icon-link" aria-label="GitHub (enpicie org)" title="GitHub — enpicie" role="listitem">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
            <span class="contact__icon-badge">org</span>
          </a>
          <a href="https://www.linkedin.com/in/noah-lee-dev/" target="_blank" rel="noopener noreferrer" class="contact__icon-link" aria-label="LinkedIn" title="LinkedIn" role="listitem">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/nav.ts';
    </script>
  </body>
</html>

<style is:global>
  /* ── Shared section shell ─────────────────────────────────────────── */
  .section {
    padding: 6rem 2rem;
    background: var(--color-paper);
    display: flex;
    justify-content: center;
  }

  .section--alt {
    background: var(--color-paper-soft);
  }

  .section__inner {
    max-width: 44rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    min-width: 0;
  }

  .section__header {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .section__heading {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    font-weight: 400;
  }

  .section__footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color 0.2s ease;
    padding: 0.5rem 0;
  }

  .more-link:hover { color: var(--color-rust); }

  /* ── Teaser cards (selected work) ─────────────────────────────────── */
  .teaser-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .teaser {
    border-top: 1px solid var(--color-rule);
  }

  .teaser:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .teaser__link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem 0;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .teaser__link:hover { color: var(--color-rust); }

  .teaser__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .teaser__icon {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid var(--color-rule);
    flex-shrink: 0;
  }

  .teaser__icon-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .teaser__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1;
    letter-spacing: 0.005em;
    color: inherit;
    font-weight: 400;
  }

  .teaser__one-line {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink);
    max-width: 36rem;
  }

  .teaser__link:hover .teaser__one-line { color: var(--color-ink); }

  .teaser__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  /* ── Tag chip ─────────────────────────────────────────────────────── */
  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0;
    padding: 0.2em 0.55em;
    background: var(--color-paper-soft);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: 3px;
  }

  .section--alt .tag {
    background: var(--color-paper);
  }

  /* ── Writing list ─────────────────────────────────────────────────── */
  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-item {
    border-top: 1px solid var(--color-rule);
  }

  .post-item:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .post-item__link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 0;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .post-item__link:hover { color: var(--color-rust); }

  .post-item__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-item__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.1;
    letter-spacing: 0.005em;
    color: inherit;
    font-weight: 400;
  }

  .post-item__date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-item__desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* ── Contact footer ───────────────────────────────────────────────── */
  .contact {
    background: var(--color-paper-soft);
    color: var(--color-ink);
    padding: 6rem 2rem;
    display: flex;
    justify-content: center;
  }

  .contact__inner {
    max-width: 44rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .contact__eyebrow {
    color: var(--color-rust);
  }

  .contact__lede {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    color: var(--color-ink);
    font-weight: 400;
  }

  .contact__lede .serif-italic {
    color: var(--color-rust);
    font-size: 0.95em;
  }

  .contact__email-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  .contact__email {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-rust);
    padding-bottom: 0.125rem;
    transition: color 0.2s ease;
    word-break: break-all;
  }

  .contact__email:hover { color: var(--color-rust); }

  .contact__copy {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-rust);
    color: var(--color-rust);
    background: transparent;
    transition: background 0.2s ease, color 0.2s ease;
    min-height: 36px;
  }

  .contact__copy:hover {
    background: var(--color-rust);
    color: var(--color-paper);
  }

  .contact__copy[data-copied="true"] {
    background: var(--color-rust);
    color: var(--color-paper);
  }

  .contact__icons {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1rem;
  }

  .contact__icon-link {
    position: relative;
    color: var(--color-ink-muted);
    opacity: 0.75;
    transition: opacity 0.2s ease, color 0.2s ease;
    display: flex;
    align-items: center;
    padding: 0.5rem;
  }

  .contact__icon-link:hover {
    color: var(--color-rust);
    opacity: 1;
  }

  .contact__icon-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    color: var(--color-context-muted);
    text-transform: lowercase;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .section { padding: 4rem 1.5rem; }
    .section__inner { gap: 2rem; }
    .contact { padding: 4rem 1.5rem; }
    .contact__email { font-size: 1.125rem; }
  }

  @media (max-width: 480px) {
    .section { padding: 3.5rem 1.25rem; }
    .contact { padding: 3.5rem 1.25rem; }
  }
</style>
