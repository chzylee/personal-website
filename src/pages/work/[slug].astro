---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import PageNav from '../../components/PageNav.astro';
import { projects, type Project } from '../../data/projects';
import { communityProjects, type CommunityProject } from '../../data/communityProjects';
import '../../styles/global.css';

const iconModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/project-icons/**/*',
  { eager: true }
);

export function getStaticPaths() {
  function slugify(title: string) {
    return title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  }

  const softwarePaths = projects.map((p) => ({
    params: { slug: slugify(p.title) },
    props: { type: 'software' as const, project: p },
  }));

  // Exclude slugs that have their own static page under work/.
  const staticPages = new Set(['midweek-mashers']);
  const communityPaths = communityProjects
    .filter((p) => !staticPages.has(p.slug))
    .map((p) => ({
      params: { slug: p.slug },
      props: { type: 'community' as const, project: p },
    }));

  return [...softwarePaths, ...communityPaths];
}

type Props =
  | { type: 'software'; project: Project }
  | { type: 'community'; project: CommunityProject };

const { type, project } = Astro.props;
const pageTitle = `${project.title} — Noah Lee`;
const pageDescription = project.oneLine;

const iconEntry = project.iconFile
  ? Object.entries(iconModules).find(([k]) => k.endsWith('/' + project.iconFile))
  : undefined;
const icon = iconEntry ? iconEntry[1].default : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <PageNav />
    <main class="detail">
      <a href="/work" class="detail__back">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
        </svg>
        All work
      </a>

      <header class="detail__header">
        <div class="detail__head">
          {icon && (
            <div class="detail__icon">
              <Image src={icon} alt="" width={64} height={64} class="detail__icon-img" />
            </div>
          )}
          <h1 class="detail__title">{project.title}</h1>
        </div>
        <p class="detail__one-line">{project.oneLine}</p>
      </header>

      <div class="detail__tags">
        {project.tags.map((t) => <span class="tag">{t}</span>)}
      </div>

      <div class="detail__links">
        {type === 'software' && (project as Project).liveUrl && (
          <a
            href={(project as Project).liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="detail__link"
          >
            Live site
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            </svg>
          </a>
        )}
        {type === 'software' && (
          <a
            href={(project as Project).githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="detail__link"
          >
            GitHub
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </a>
        )}
        {type === 'community' && (project as CommunityProject).liveUrl && (
          <a
            href={(project as CommunityProject).liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="detail__link"
          >
            Website
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            </svg>
          </a>
        )}
      </div>

      <section class="detail__section">
        <span class="eyebrow eyebrow--rust">Why I built it</span>
        <p class="detail__body">{project.whyBuilt}</p>
      </section>

      <section class="detail__section">
        <span class="eyebrow eyebrow--rust">What changed</span>
        <p class="detail__body">{project.whatChanged}</p>
      </section>
    </main>
  </body>
</html>

<style>
  .detail {
    max-width: 38rem;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 2.5rem) 2rem 4rem;
    background: var(--color-paper);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .detail__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    transition: color 0.2s ease;
    padding: 0.5rem 0;
    align-self: flex-start;
  }

  .detail__back:hover { color: var(--color-rust); }

  .detail__header {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .detail__head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .detail__icon {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid var(--color-rule);
    flex-shrink: 0;
  }

  .detail__icon-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .detail__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: 0.005em;
    color: var(--color-ink);
    font-weight: 400;
  }

  .detail__one-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--color-ink);
  }

  .detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0;
    padding: 0.2em 0.55em;
    background: var(--color-paper-soft);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: 3px;
  }

  .detail__links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-top: 0.25rem;
  }

  .detail__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color 0.2s ease;
    padding: 0.5rem 0;
  }

  .detail__link:hover { color: var(--color-rust); }

  .detail__section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
  }

  .detail__body {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
  }

  @media (max-width: 480px) {
    .detail { padding: calc(var(--nav-height) + 1.5rem) 1.25rem 3rem; }
  }
</style>
