---
import { projects, type Project } from '../../data/projects';
import { communityProjects, type CommunityProject } from '../../data/communityProjects';
import PageNav from '../../components/PageNav.astro';
import '../../styles/global.css';

export function getStaticPaths() {
  function slugify(title: string) {
    return title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  }

  const softwarePaths = projects.map((p) => ({
    params: { slug: slugify(p.title) },
    props: { type: 'software' as const, project: p },
  }));

  const communityPaths = communityProjects.map((p) => ({
    params: { slug: p.slug },
    props: { type: 'community' as const, project: p },
  }));

  return [...softwarePaths, ...communityPaths];
}

type Props =
  | { type: 'software'; project: Project }
  | { type: 'community'; project: CommunityProject };

const { type, project } = Astro.props;
const pageTitle = `${project.title} — Noah Lee`;
const pageDescription = type === 'software' ? project.description : project.summary;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <PageNav />
    <div class="page">
      <main>
        {type === 'software' ? (
          <!-- Software project layout -->
          <article class="work-detail">
            <header class="work-detail__header">
              <h1 class="work-detail__title">{project.title}</h1>
              <div class="work-detail__links">
                {(project as Project).liveUrl && (
                  <a
                    href={(project as Project).liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="detail-link"
                  >
                    Live site
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    </svg>
                  </a>
                )}
                <a
                  href={(project as Project).githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="detail-link"
                >
                  GitHub
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                    <path d="M9 18c-4.51 2-5-2-7-2"/>
                  </svg>
                </a>
              </div>
            </header>

            <div class="work-detail__tags">
              {(project as Project).tags.map((t) => <span class="tag">{t}</span>)}
            </div>

            <p class="work-detail__desc">{(project as Project).description}</p>
          </article>
        ) : (
          <!-- Community project layout -->
          <article class="work-detail">
            <header class="work-detail__header">
              <h1 class="work-detail__title">{project.title}</h1>
              {(project as CommunityProject).liveUrl && (
                <div class="work-detail__links">
                  <a
                    href={(project as CommunityProject).liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="detail-link"
                  >
                    Website
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    </svg>
                  </a>
                </div>
              )}
            </header>

            <div class="work-detail__tags">
              {(project as CommunityProject).tags.map((t) => <span class="tag">{t}</span>)}
            </div>

            <p class="work-detail__summary">{(project as CommunityProject).summary}</p>

            <div class="case-study">
              <section class="case-study__section">
                <h2 class="case-study__heading">Overview</h2>
                <p class="case-study__body">Case study content coming soon.</p>
              </section>

              <section class="case-study__section">
                <h2 class="case-study__heading">What I Built</h2>
                <p class="case-study__body">Case study content coming soon.</p>
              </section>

              <section class="case-study__section">
                <h2 class="case-study__heading">Results</h2>
                <p class="case-study__body">Case study content coming soon.</p>
              </section>

              <section class="case-study__section">
                <h2 class="case-study__heading">Lessons Learned</h2>
                <p class="case-study__body">Case study content coming soon.</p>
              </section>
            </div>
          </article>
        )}
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 3rem) 2rem 2rem;
  }

  @media (max-width: 480px) {
    .page { padding: calc(var(--nav-height) + 2rem) 1rem 1.5rem; }
  }

  .work-detail__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .work-detail__title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text);
  }

  .work-detail__links {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
    margin-top: 0.375rem;
  }

  .detail-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .detail-link:hover { color: var(--color-text); }

  .work-detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    font-size: 0.6875rem;
    font-family: monospace;
    letter-spacing: 0.04em;
    padding: 0.2em 0.6em;
    background: #181818;
    color: #666;
    border-radius: 3px;
  }

  .work-detail__desc,
  .work-detail__summary {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
    opacity: 0.85;
  }

  /* Case study sections */
  .case-study {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .case-study__section {
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .case-study__heading {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .case-study__body {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
    opacity: 0.85;
  }
</style>
