---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import PageNav from '../../components/PageNav.astro';
import { projects } from '../../data/projects';
import { communityProjects } from '../../data/communityProjects';
import '../../styles/global.css';

const iconModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/project-icons/**/*',
  { eager: true }
);
function resolveIcon(iconFile?: string) {
  if (!iconFile) return undefined;
  const entry = Object.entries(iconModules).find(([k]) => k.endsWith('/' + iconFile));
  return entry ? entry[1].default : undefined;
}
function slugify(title: string) {
  return title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const orderedDevTitles = [
  'adomi-san-bot',
  'FindMyFGC',
  'NEST',
  'FGC League Sheets',
  'Melty Frame Data Bot',
];

const community = communityProjects.find((p) => p.title === 'Midweek Mashers');
const devProjects = orderedDevTitles
  .map((title) => projects.find((p) => p.title === title))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const description =
  "The work of Noah Lee — six years of cloud infrastructure engineering, plus community building in the fighting game scene. Two contexts, same instinct.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Work — Noah Lee" description={description} />
  </head>
  <body>
    <PageNav />

    <aside class="work-sidenav" aria-label="Work sections">
      <div class="work-sidenav__group">
        <span class="work-sidenav__label">Part one — Engineering</span>
        {devProjects.map((p) => (
          <a
            href={`#${slugify(p.title)}`}
            class="work-sidenav__link"
            data-sidenav-link
          >{p.title}</a>
        ))}
      </div>

      <div class="work-sidenav__group">
        <span class="work-sidenav__label">Part two — Community</span>
        {community && (
          <a
            href={`#${community.slug}`}
            class="work-sidenav__link"
            data-sidenav-link
          >{community.title}</a>
        )}
        <a
          href="#fgc-in-detail"
          class="work-sidenav__link"
          data-sidenav-link
        >FGC, in detail</a>
      </div>

      <a href="/#contact" class="work-sidenav__cta">Contact me</a>
    </aside>

    <main class="work-page">
      <header class="work-page__intro reveal">
        <span class="eyebrow">Selected work</span>
        <h1 class="work-page__title">
          Two contexts.
          <em class="serif-italic">Same instinct.</em>
        </h1>
        <ol class="instinct-flow" aria-label="The instinct, in three steps">
          <li class="instinct-flow__step">Understand the person</li>
          <li class="instinct-flow__step">Find the friction</li>
          <li class="instinct-flow__step">Build what removes it</li>
        </ol>
        <p class="work-page__lede">
          Leveraging professional software engineering expertise to build systems for people around me. Always working on something new.
        </p>
      </header>

      <!-- ── Part one — Engineering ───────────────────────────────── -->
      <section class="work-section" aria-labelledby="engineering-heading">
        <header class="work-section__header reveal">
          <span class="eyebrow eyebrow--rust">Part one</span>
          <h2 class="work-section__title" id="engineering-heading">Engineering work</h2>
          <p class="work-section__lede">
            Systems I built and shipped.
          </p>
        </header>

        {devProjects.map((p, i) => {
          const icon = resolveIcon(p.iconFile);
          const projectId = slugify(p.title);
          return (
            <article class="entry reveal" style={`--reveal-delay: ${i * 70}ms`} id={projectId}>
              <div class="entry__head">
                {icon && (
                  <div class="entry__icon">
                    <Image src={icon} alt="" width={48} height={48} class="entry__icon-img" />
                  </div>
                )}
                <h3 class="entry__title">
                  <a href={`/work/${projectId}`}>{p.title}</a>
                </h3>
              </div>

              <p class="entry__one-line">{p.oneLine}</p>

              <div class="entry__why">
                <span class="eyebrow eyebrow--rust">Why I built it</span>
                <p class="entry__body">{p.whyBuilt}</p>
              </div>

              <div class="entry__changed">
                <span class="eyebrow eyebrow--rust">What changed</span>
                <p class="entry__body">{p.whatChanged}</p>
              </div>

              <div class="entry__meta">
                <div class="entry__tags">
                  {p.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
                <div class="entry__links">
                  {p.liveUrl && (
                    <a
                      href={p.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="entry__link"
                    >
                      Live
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      </svg>
                    </a>
                  )}
                  <a
                    href={p.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="entry__link"
                  >
                    GitHub
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                      <path d="M9 18c-4.51 2-5-2-7-2"/>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </section>

      <!-- ── Part two — Community ─────────────────────────────────── -->
      <section class="work-section" aria-labelledby="community-heading">
        <header class="work-section__header reveal">
          <span class="eyebrow eyebrow--rust">Part two</span>
          <h2 class="work-section__title" id="community-heading">Community work</h2>
          <p class="work-section__lede">
            The scene I grew up in, and the structure I built to help it grow.
          </p>
        </header>

        {community && (
          <article class="entry reveal" id={community.slug}>
            <div class="entry__head">
              {(() => {
                const icon = resolveIcon(community.iconFile);
                return icon && (
                  <div class="entry__icon">
                    <Image src={icon} alt="" width={48} height={48} class="entry__icon-img" />
                  </div>
                );
              })()}
              <h3 class="entry__title">
                <a href={`/work/${community.slug}`}>{community.title}</a>
              </h3>
            </div>

            <p class="entry__one-line">{community.oneLine}</p>

            <div class="entry__why">
              <span class="eyebrow eyebrow--rust">Why I built it</span>
              <p class="entry__body">{community.whyBuilt}</p>
            </div>

            <div class="entry__changed">
              <span class="eyebrow eyebrow--rust">What changed</span>
              <p class="entry__body">{community.whatChanged}</p>
            </div>

            <div class="entry__meta">
              <div class="entry__tags">
                {community.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
              <div class="entry__links">
                <a href={`/work/${community.slug}`} class="entry__link">
                  Deep dive
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        )}

        <article class="entry entry--pointer reveal" style="--reveal-delay: 70ms" id="fgc-in-detail">
          <div class="entry__head">
            <h3 class="entry__title">
              <a href="/fgc">FGC, in detail</a>
            </h3>
          </div>

          <p class="entry__one-line">
            Commentary, special events, connecting with different scenes.
          </p>

          <p class="entry__body entry__body--pointer">
            Beyond Midweek Mashers, I am involved in supporting the FGC in different capacities. I work at various events, commentate anime games, craft unofficial side events, and get to know my community across regions.
          </p>

          <div class="entry__meta">
            <div class="entry__tags">
              <span class="tag">Commentary</span>
              <span class="tag">Events</span>
              <span class="tag">Graphics</span>
              <span class="tag">Travel</span>
            </div>
            <a href="/fgc" class="entry__link">
              Full Details
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      </section>

      <footer class="work-page__outro">
        <p class="work-page__outro-text">
          Looking for something specific, or want to talk about a project?
          <a href="/#contact"><em class="serif-italic">Get in touch</em></a>.
        </p>
      </footer>
    </main>

    <script>
      import '../../scripts/reveal.ts';

      const links = document.querySelectorAll<HTMLAnchorElement>('[data-sidenav-link]');
      const idToLink = new Map<string, HTMLAnchorElement>();
      const targets: HTMLElement[] = [];

      links.forEach((link) => {
        const id = link.getAttribute('href')?.slice(1);
        if (!id) return;
        const target = document.getElementById(id);
        if (target) {
          idToLink.set(id, link);
          targets.push(target);
        }
      });

      function setActive(activeId: string) {
        idToLink.forEach((link, id) => {
          link.classList.toggle('is-active', id === activeId);
        });
      }

      if (targets.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (visible) setActive(visible.target.id);
          },
          { rootMargin: '-25% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
        );
        targets.forEach((t) => observer.observe(t));
      }
    </script>
  </body>
</html>

<style>
  .work-page {
    max-width: 44rem;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 4rem) 2rem 4rem;
    background: var(--color-paper);
  }

  /* ── Intro ─────────────────────────────────────────────────────── */
  .work-page__intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  .work-page__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    font-weight: 400;
  }

  .work-page__title .serif-italic {
    color: var(--color-rust);
    display: block;
    font-size: 0.85em;
    margin-top: 0.1em;
  }

  /* ── Instinct flow ─────────────────────────────────────────────── */
  .instinct-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1rem;
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .instinct-flow__step {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .instinct-flow__step + .instinct-flow__step::before {
    content: "\2192";
    color: var(--color-rust);
    font-size: 1rem;
  }

  .work-page__lede {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-ink);
    max-width: 36rem;
  }

  /* ── Section ──────────────────────────────────────────────────── */
  .work-section {
    margin-top: 4rem;
  }

  .work-section__header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 3rem;
    margin-bottom: 1rem;
    border-top: 2px solid var(--color-ink);
    scroll-margin-top: calc(var(--nav-height) + 1.5rem);
  }

  .work-section__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-ink);
    font-weight: 400;
  }

  .work-section__lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--color-ink-muted);
    max-width: 36rem;
  }

  /* ── Entry ─────────────────────────────────────────────────────── */
  .entry {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 3.5rem 0;
    border-top: 1px solid var(--color-rule);
    scroll-margin-top: calc(var(--nav-height) + 1.5rem);
  }

  .entry:first-of-type { border-top: none; padding-top: 2.5rem; }

  .entry__head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .entry__icon {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid var(--color-rule);
    flex-shrink: 0;
  }

  .entry__icon-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .entry__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: 0.005em;
    color: var(--color-ink);
    font-weight: 400;
  }

  .entry__title a {
    color: inherit;
    transition: color 0.2s ease;
  }

  .entry__title a:hover { color: var(--color-rust); }

  .entry__one-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--color-ink);
    max-width: 36rem;
  }

  .entry__why,
  .entry__changed {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-width: 36rem;
  }

  .entry__body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink);
  }

  .entry__body--pointer {
    color: var(--color-ink-muted);
    max-width: 36rem;
  }

  .entry--pointer {
    background: var(--color-paper-soft);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    padding: 2.5rem 2rem;
    margin-top: 1rem;
  }

  .entry--pointer + .entry,
  .work-section .entry--pointer:first-of-type { border-top: none; }

  .entry__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0;
    padding: 0.2em 0.55em;
    background: var(--color-paper-soft);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: 3px;
  }

  .entry__links {
    display: flex;
    gap: 1.25rem;
  }

  .entry__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color 0.2s ease;
    padding: 0.5rem 0;
  }

  .entry__link:hover { color: var(--color-rust); }

  /* ── Side nav (desktop only) ─────────────────────────────────── */
  .work-sidenav {
    position: fixed;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    width: 13rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    z-index: 50;
    max-height: 75vh;
    overflow-y: auto;
    padding: 0.5rem 0;
  }

  .work-sidenav__group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .work-sidenav__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-rust);
    margin-bottom: 0.5rem;
  }

  .work-sidenav__cta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-top: 0.5rem;
    transition: color 0.2s ease;
  }

  .work-sidenav__cta:hover {
    color: var(--color-rust);
  }

  .work-sidenav__link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-ink-muted);
    padding: 0.25rem 0 0.25rem 0.875rem;
    border-left: 1px solid var(--color-rule);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .work-sidenav__link:hover {
    color: var(--color-ink);
    border-left-color: var(--color-ink-muted);
  }

  .work-sidenav__link.is-active {
    color: var(--color-rust);
    border-left-color: var(--color-rust);
  }

  /* ── Outro ─────────────────────────────────────────────────────── */
  .work-page__outro {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-rule);
  }

  .work-page__outro-text {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-ink);
  }

  .work-page__outro-text a {
    color: var(--color-rust);
    border-bottom: 1px solid var(--color-rust);
    transition: color 0.2s ease, border-color 0.2s ease;
    padding: 0 0.25rem;
  }

  .work-page__outro-text a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  /* ── Mobile / narrow desktop ──────────────────────────────── */
  @media (max-width: 1180px) {
    .work-sidenav { display: none; }
  }

  @media (max-width: 640px) {
    .work-page {
      padding: calc(var(--nav-height) + 2rem) 1.5rem 3rem;
    }
    .work-page__intro { margin-bottom: 3rem; }
    .instinct-flow { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    .work-section { margin-top: 3rem; }
    .work-section__header { padding-top: 2rem; }
    .entry { padding: 2.5rem 0; gap: 1.25rem; }
    .entry--pointer { padding: 2rem 1.5rem; }
    .entry__one-line { font-size: 1.125rem; }
  }

  @media (max-width: 480px) {
    .work-page { padding: calc(var(--nav-height) + 1.5rem) 1.25rem 2.5rem; }
  }
</style>
