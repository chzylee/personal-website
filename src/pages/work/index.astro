---
import { projects } from '../../data/projects';
import { communityProjects } from '../../data/communityProjects';
import '../../styles/global.css';

function slugify(title: string) {
  return title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The work of Noah Lee — software projects, community building, and event organization." />
    <meta property="og:title" content="Work — Noah Lee" />
    <meta property="og:description" content="The work of Noah Lee — software projects, community building, and event organization." />
    <title>Work — Noah Lee</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="page">
      <nav class="page-nav">
        <a href="/" class="page-nav__home">Noah Lee</a>
      </nav>

      <main>
        <!-- Software Projects -->
        <section class="work-section">
          <h1 class="section-label">Software Projects</h1>

          <ul class="card-list">
            {projects.map((p) => (
              <li class="card">
                <div class="card__header">
                  <a href={`/work/${slugify(p.title)}`} class="card__title">{p.title}</a>
                  <div class="card__icons">
                    {p.liveUrl && (
                      <a
                        href={p.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="card__icon-link"
                        aria-label={`${p.title} live site`}
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        </svg>
                      </a>
                    )}
                    <a
                      href={p.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="card__icon-link"
                      aria-label={`${p.title} on GitHub`}
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                        <path d="M9 18c-4.51 2-5-2-7-2"/>
                      </svg>
                    </a>
                  </div>
                </div>
                <p class="card__desc">{p.description}</p>
                <div class="card__tags">
                  {p.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- Community & Events -->
        <section class="work-section">
          <h2 class="section-label">Community &amp; Events</h2>

          <ul class="card-list">
            {communityProjects.map((p) => (
              <li class="card">
                <div class="card__header">
                  <a href={`/work/${p.slug}`} class="card__title">{p.title}</a>
                  <div class="card__icons">
                    {p.liveUrl && (
                      <a
                        href={p.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="card__icon-link"
                        aria-label={`${p.title} website`}
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
                <p class="card__desc">{p.summary}</p>
                <div class="card__tags">
                  {p.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
              </li>
            ))}
          </ul>
        </section>
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem;
  }

  @media (max-width: 480px) {
    .page { padding: 1.5rem 1rem; }
  }

  .page-nav {
    margin-bottom: 3rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-nav__home {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-text);
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .page-nav__home:hover { opacity: 1; }

  .work-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .work-section:last-child { margin-bottom: 0; }

  .section-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .card-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .card {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .card:first-child { padding-top: 0; }
  .card:last-child  { border-bottom: none; }

  .card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.625rem;
  }

  .card__title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.3;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .card__title:hover { opacity: 1; }

  .card__icons {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .card__icon-link {
    color: var(--color-text);
    opacity: 0.35;
    transition: opacity 0.2s ease;
  }

  .card__icon-link:hover { opacity: 1; }

  .card__desc {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 0.875rem;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    font-size: 0.6875rem;
    font-family: monospace;
    letter-spacing: 0.04em;
    padding: 0.2em 0.6em;
    background: #181818;
    color: #666;
    border-radius: 3px;
  }
</style>
