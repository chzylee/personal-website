---
import { getCollection } from 'astro:content';
import PageNav from '../../components/PageNav.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const date = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={post.data.description} />
    <meta property="og:title" content={`${post.data.title} — Noah Lee`} />
    <meta property="og:description" content={post.data.description} />
    <title>{post.data.title} — Noah Lee</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <PageNav />
    <div class="page">
      <main class="post">
        <header class="post__header">
          <time class="post__date" datetime={post.data.date.toISOString()}>{date}</time>
          <h1 class="post__title">{post.data.title}</h1>
          <p class="post__desc">{post.data.description}</p>
        </header>

        <div class="post__body">
          <Content />
        </div>
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 3rem) 2rem 2rem;
  }

  @media (max-width: 480px) {
    .page { padding: calc(var(--nav-height) + 2rem) 1rem 1.5rem; }
  }

  .post__header {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post__date {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .post__title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text);
  }

  .post__desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* Prose — use :global() because <Content /> renders outside Astro's scope */
  .post__body {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
    opacity: 0.85;
  }

  .post__body :global(h2) {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    opacity: 1;
  }

  .post__body :global(h3) {
    font-size: 0.9375rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    opacity: 1;
  }

  .post__body :global(p) {
    margin-bottom: 1.25rem;
  }

  .post__body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(232, 232, 232, 0.35);
    transition: text-decoration-color 0.2s ease;
  }

  .post__body :global(a:hover) {
    text-decoration-color: rgba(232, 232, 232, 0.8);
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .post__body :global(li) {
    margin-bottom: 0.375rem;
  }

  .post__body :global(code) {
    font-family: monospace;
    font-size: 0.875em;
    background: #181818;
    padding: 0.15em 0.4em;
    border-radius: 3px;
    color: var(--color-text);
  }

  .post__body :global(pre) {
    background: #181818;
    padding: 1.25rem;
    border-radius: 4px;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    border: 1px solid var(--color-border);
  }

  .post__body :global(pre code) {
    background: none;
    padding: 0;
  }

  .post__body :global(blockquote) {
    border-left: 2px solid var(--color-border);
    padding-left: 1.25rem;
    margin-left: 0;
    margin-bottom: 1.25rem;
    color: var(--color-text-muted);
  }

  .post__body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
</style>
