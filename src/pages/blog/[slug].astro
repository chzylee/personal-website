---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import PageNav from '../../components/PageNav.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const date = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${post.data.title} · Noah Lee`}
      description={post.data.description}
    />
  </head>
  <body>
    <PageNav />
    <main class="page">
      <a href="/blog" class="post__back">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
        </svg>
        All writing
      </a>

      <article class="post">
        <header class="post__header reveal">
          <time class="post__date" datetime={post.data.date.toISOString()}>{date}</time>
          <h1 class="post__title">{post.data.title}</h1>
          <p class="post__desc">{post.data.description}</p>
        </header>

        <div class="post__body">
          <Content />
        </div>
      </article>
    </main>

    <script>
      import '../../scripts/reveal.ts';
    </script>
  </body>
</html>

<style>
  .page {
    max-width: 38rem;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 2.5rem) 2rem 4rem;
    background: var(--color-paper);
  }

  .post__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    transition: color 0.2s ease;
    padding: 0.5rem 0;
    margin-bottom: 1.5rem;
  }

  .post__back:hover { color: var(--color-rust); }

  .post__header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .post__date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-rust);
  }

  .post__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    font-weight: 400;
  }

  .post__desc {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .post__body {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink);
  }

  .post__body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.1;
    letter-spacing: 0;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--color-ink);
    font-weight: 400;
  }

  .post__body :global(h3) {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--color-ink);
  }

  .post__body :global(p) {
    margin-bottom: 1.25rem;
  }

  .post__body :global(a) {
    color: var(--color-rust);
    border-bottom: 1px solid var(--color-rust);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .post__body :global(a:hover) {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .post__body :global(em) {
    font-family: var(--font-serif);
    font-style: italic;
  }

  .post__body :global(strong) {
    font-weight: 600;
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .post__body :global(li) {
    margin-bottom: 0.375rem;
  }

  .post__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-paper-soft);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
  }

  .post__body :global(pre) {
    background: var(--color-context-bg);
    color: var(--color-context-ink);
    padding: 1.25rem;
    border-radius: 4px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .post__body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
  }

  .post__body :global(blockquote) {
    border-left: 3px solid var(--color-rust);
    padding-left: 1.25rem;
    margin-left: 0;
    margin-bottom: 1.25rem;
    color: var(--color-ink-muted);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.125rem;
  }

  .post__body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-rule);
    margin: 2.5rem 0;
  }

  @media (max-width: 480px) {
    .page { padding: calc(var(--nav-height) + 1.5rem) 1.25rem 3rem; }
  }
</style>
