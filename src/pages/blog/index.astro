---
import { getCollection } from 'astro:content';
import PageNav from '../../components/PageNav.astro';
import '../../styles/global.css';

const allPosts = await getCollection('writing', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Writing by Noah Lee — thoughts on engineering, community building, and more." />
    <meta property="og:title" content="Writing — Noah Lee" />
    <meta property="og:description" content="Writing by Noah Lee — thoughts on engineering, community building, and more." />
    <title>Writing — Noah Lee</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <PageNav />
    <div class="page">
      <main>
        <h1 class="page-title">Writing</h1>

        <ul class="post-list">
          {posts.map((post) => {
            const date = post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            });
            return (
              <li class="post-item">
                <div class="post-item__row">
                  <a href={`/blog/${post.slug}`} class="post-item__title">{post.data.title}</a>
                  <time class="post-item__date" datetime={post.data.date.toISOString()}>{date}</time>
                </div>
                <p class="post-item__desc">{post.data.description}</p>
              </li>
            );
          })}
        </ul>
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 3rem) 2rem 2rem;
  }

  @media (max-width: 480px) {
    .page { padding: calc(var(--nav-height) + 2rem) 1rem 1.5rem; }
  }

  .page-title {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-item {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-item:first-child { padding-top: 0; }
  .post-item:last-child  { border-bottom: none; }

  .post-item__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-item__title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    transition: opacity 0.2s ease;
  }

  .post-item__title:hover { opacity: 0.75; }

  .post-item__date {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-item__desc {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
