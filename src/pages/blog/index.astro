---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import PageNav from '../../components/PageNav.astro';
import '../../styles/global.css';

const allPosts = await getCollection('writing', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Writing — Noah Lee"
      description="Writing by Noah Lee — notes on engineering, community building, and the FGC."
    />
  </head>
  <body>
    <PageNav />
    <main class="page">
      <header class="page__header">
        <span class="eyebrow">Writing</span>
        <h1 class="page__title">Notes from the work.</h1>
      </header>

      <ul class="post-list">
        {posts.map((post) => {
          const date = post.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC',
          });
          return (
            <li class="post-item">
              <a href={`/blog/${post.slug}`} class="post-item__link">
                <div class="post-item__row">
                  <h2 class="post-item__title">{post.data.title}</h2>
                  <time class="post-item__date" datetime={post.data.date.toISOString()}>{date}</time>
                </div>
                <p class="post-item__desc">{post.data.description}</p>
              </a>
            </li>
          );
        })}
      </ul>
    </main>
  </body>
</html>

<style>
  .page {
    max-width: 44rem;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 3rem) 2rem 4rem;
    background: var(--color-paper);
  }

  .page__header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .page__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    font-weight: 400;
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-item {
    border-top: 1px solid var(--color-rule);
  }

  .post-item:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .post-item__link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 0;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .post-item__link:hover { color: var(--color-rust); }

  .post-item__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-item__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 1.875rem);
    line-height: 1.1;
    color: inherit;
    font-weight: 400;
  }

  .post-item__date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-item__desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  @media (max-width: 480px) {
    .page { padding: calc(var(--nav-height) + 2rem) 1.25rem 3rem; }
  }
</style>
